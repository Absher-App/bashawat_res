DB_HOST=127.0.0.1
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
PORT=3000

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

### Payments (Stripe) ###
# To enable Apple Pay on the website, set these keys (and configure Apple Pay domain in Stripe Dashboard).
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Optional for webhook verification if you later enable automatic WhatsApp sending via server
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Public URL of your website (used to build success/cancel URLs)
SITE_URL=https://yourdomain.com

