<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'ar' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'rtl' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t.parties.title %> - <%= t.common.brandName %> - <%= t.common.brandEn %></title>
    <meta name="description" content="<%= t.parties.title %> - <%= t.common.brandName %>.">
    <meta name="keywords" content="<%= t.common.brandName %>، حفلات، مناسبات، بوفيه">
    <meta name="author" content="<%= t.common.brandName %>">
    <% if (typeof siteUrl !== 'undefined' && siteUrl) { %>
    <link rel="canonical" href="<%= siteUrl %>/parties">
    <meta property="og:url" content="<%= siteUrl %>/parties">
    <% } %>
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= t.parties.title %> - <%= t.common.brandName %> - <%= t.common.brandEn %>">
    <meta property="og:description" content="<%= t.parties.title %> - <%= t.common.brandName %>.">
    <meta property="og:locale" content="ar_SA">
    <meta property="og:image" content="<%= typeof siteUrl !== 'undefined' && siteUrl ? siteUrl : '' %>/images/logo.png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= t.parties.title %> - <%= t.common.brandName %>">
    <meta name="twitter:description" content="<%= t.parties.title %> - <%= t.common.brandName %>.">
    <link rel="icon" href="/images/logo.png" type="image/png">
    <link rel="stylesheet" href="/css/style.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>
    <header class="site-header">
        <div class="offers-banner">
            <% const partiesOfferText = typeof offer_text !== 'undefined' && offer_text ? offer_text : (typeof t !== 'undefined' && t.offer ? '✨ ' + t.offer : ''); %>
            <div class="offers-marquee-wrap" aria-hidden="true">
                <span class="offers-text"><%= partiesOfferText %></span>
                <span class="offers-text"><%= partiesOfferText %></span>
            </div>
        </div>
        <nav class="topbar">
            <div class="container topbar-content">
                <a href="/" class="logo-area">
                    <img src="/images/logo.png" alt="<%= t.common.brandName %>" class="nav-logo">
                    <span class="brand-name"><%= t.common.brandName %> <em class="brand-en"><%= t.common.brandEn %></em></span>
                </a>
                <ul class="nav-links">
                    <li><a href="/" class="nav-link"><%= t.nav.home %></a></li>
                    <li><a href="/products" class="nav-link"><%= t.nav.products %></a></li>
                    <li><a href="/parties" class="nav-link active"><%= t.nav.parties %></a></li>
                    <li><a href="/cart" class="nav-link nav-cart"><%= t.nav.cart %> <i class="fas fa-shopping-cart"></i></a></li>
                </ul>
                <div class="topbar-social">
                    <a href="https://www.instagram.com/bodatbagdash/" target="_blank" rel="noopener" aria-label="انستغرام"><i class="fab fa-instagram"></i></a>
                    <a href="https://x.com/BodatBagdash" target="_blank" rel="noopener" aria-label="تويتر"><i class="fab fa-twitter"></i></a>
                    <a href="https://www.snapchat.com/@bagdashsweet" target="_blank" rel="noopener" aria-label="سناب شات"><i class="fab fa-snapchat-ghost"></i></a>
                    <a href="https://www.tiktok.com/@bagdashsweet" target="_blank" rel="noopener" aria-label="تيك توك"><i class="fab fa-tiktok"></i></a>
                    <a href="https://www.facebook.com/bagdashsweet/" target="_blank" rel="noopener" aria-label="فيسبوك"><i class="fab fa-facebook-f"></i></a>
                </div>
                <%- include('partials/lang-switcher') %>
                <button type="button" class="burger-btn" id="burgerBtn" aria-label="<%= t.nav.menu %>"><span></span><span></span><span></span></button>
            </div>
        </nav>
    </header>
    <div class="drawer-overlay" id="drawerOverlay" aria-hidden="true"></div>
    <div class="drawer" id="drawer">
        <div class="drawer-header">
            <span class="drawer-title"><%= t.nav.menu %></span>
            <button type="button" class="drawer-close" id="drawerClose" aria-label="<%= t.nav.close %>"><i class="fas fa-times"></i></button>
        </div>
        <nav class="drawer-nav">
            <a href="/" class="drawer-link"><%= t.nav.home %></a>
            <a href="/products" class="drawer-link"><%= t.nav.products %></a>
            <a href="/parties" class="drawer-link active"><%= t.nav.parties %></a>
            <a href="/cart" class="drawer-link"><%= t.nav.cart %> <i class="fas fa-shopping-cart"></i></a>
        </nav>
        <div class="drawer-lang"><%- include('partials/lang-switcher') %></div>
        <div class="drawer-social">
            <span class="drawer-social-label"><%= t.nav.followUs %></span>
            <a href="https://www.instagram.com/bodatbagdash/" target="_blank" rel="noopener" aria-label="انستغرام"><i class="fab fa-instagram"></i></a>
            <a href="https://x.com/BodatBagdash" target="_blank" rel="noopener" aria-label="تويتر"><i class="fab fa-twitter"></i></a>
            <a href="https://www.snapchat.com/@bagdashsweet" target="_blank" rel="noopener" aria-label="سناب شات"><i class="fab fa-snapchat-ghost"></i></a>
            <a href="https://www.tiktok.com/@bagdashsweet" target="_blank" rel="noopener" aria-label="تيك توك"><i class="fab fa-tiktok"></i></a>
            <a href="https://www.facebook.com/bagdashsweet/" target="_blank" rel="noopener" aria-label="فيسبوك"><i class="fab fa-facebook-f"></i></a>
        </div>
    </div>

    <!-- Floating Cart Button -->
    <a href="/cart" class="cart-floating-btn" id="cartBtn">
        <i class="fas fa-shopping-cart"></i>
        <span class="cart-count" id="cartCount">0</span>
    </a>

    <!-- Header / Hero Section -->
    <header class="parties-page-header" style="background-image: url('https://images.unsplash.com/photo-1530103862676-de3c9a59af38?ixlib=rb-1.2.1&auto=format&fit=crop&w=1950&q=80');">
        <div class="overlay"></div>
        <div class="parties-header-content">
            <div class="parties-header-icon"><i class="fas fa-glass-cheers"></i></div>
            <h1><%= t.parties.title %></h1>
            <p><%= t.parties.subtitle %></p>
        </div>
    </header>

    <div class="container parties-container">
        <!-- Section Title -->
        <div class="parties-intro">
            <span class="parties-badge"><%= t.parties.quickLinks %></span>
            <h2 class="parties-section-title"><%= t.parties.title %></h2>
            <p class="parties-section-desc"><%= t.parties.sectionDesc %></p>
        </div>

        <!-- Services Grid -->
        <section class="parties-grid">
            <article class="service-card-pro" style="--card-img: url('https://images.unsplash.com/photo-1558636508-e0db3814bd1d?w=600&q=80');">
                <div class="service-card-img"></div>
                <div class="service-card-body">
                    <div class="service-icon-wrapper">
                        <i class="fas fa-birthday-cake"></i>
                    </div>
                    <h3><%= t.parties.service1Title %></h3>
                    <p><%= t.parties.service1Desc %></p>
                </div>
            </article>
            
            <article class="service-card-pro" style="--card-img: url('https://images.unsplash.com/photo-1519741497674-611481863552?w=600&q=80');">
                <div class="service-card-img"></div>
                <div class="service-card-body">
                    <div class="service-icon-wrapper">
                        <i class="fas fa-ring"></i>
                    </div>
                    <h3><%= t.parties.service2Title %></h3>
                    <p><%= t.parties.service2Desc %></p>
                </div>
            </article>
            
            <article class="service-card-pro" style="--card-img: url('https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=600&q=80');">
                <div class="service-card-img"></div>
                <div class="service-card-body">
                    <div class="service-icon-wrapper">
                        <i class="fas fa-building"></i>
                    </div>
                    <h3><%= t.parties.service3Title %></h3>
                    <p><%= t.parties.service3Desc %></p>
                </div>
            </article>

            <article class="service-card-pro" style="--card-img: url('https://images.unsplash.com/photo-1579954115545-a95591f28bfc?w=600&q=80');">
                <div class="service-card-img"></div>
                <div class="service-card-body">
                    <div class="service-icon-wrapper">
                        <i class="fas fa-ice-cream"></i>
                    </div>
                    <h3><%= t.parties.service4Title %></h3>
                    <p><%= t.parties.service4Desc %></p>
                </div>
            </article>
        </section>

        <!-- Booking Call to Action -->
        <section class="booking-section">
            <div class="booking-content">
                <h2><%= t.parties.bookingTitle %></h2>
                <p><%= t.parties.bookingDesc %></p>
                <a href="https://wa.me/966502975175" class="whatsapp-cta-btn" target="_blank">
                    <i class="fab fa-whatsapp"></i>
                    <%= t.parties.bookingBtn %>
                </a>
            </div>
        </section>
    </div>

    <!-- Footer -->
    <footer class="main-footer">
        <div class="footer-content container">
            <div class="footer-col">
                <h3><%= t.footer.brand %></h3>
                <p><%= t.footer.tagline %></p>
            </div>
            <div class="footer-col">
                <h3><%= t.footer.quickLinks %></h3>
                <ul>
                    <li><a href="/"><%= t.nav.home %></a></li>
                    <li><a href="/#products-section"><%= t.nav.products %></a></li>
                    <li><a href="/parties"><%= t.nav.parties %></a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h3><%= t.footer.contact %></h3>
                <p><i class="fas fa-phone"></i> 054 262 9993</p>
                <p><i class="fas fa-map-marker-alt"></i> الدمام • طريق الملك بن عبدالله</p>
                <div class="footer-social">
                    <a href="https://www.instagram.com/bodatbagdash/" target="_blank" rel="noopener" aria-label="انستغرام"><i class="fab fa-instagram"></i></a>
                    <a href="https://x.com/BodatBagdash" target="_blank" rel="noopener" aria-label="تويتر"><i class="fab fa-twitter"></i></a>
                    <a href="https://www.snapchat.com/@bagdashsweet" target="_blank" rel="noopener" aria-label="سناب شات"><i class="fab fa-snapchat-ghost"></i></a>
                    <a href="https://www.tiktok.com/@bagdashsweet" target="_blank" rel="noopener" aria-label="تيك توك"><i class="fab fa-tiktok"></i></a>
                    <a href="https://www.facebook.com/bagdashsweet/" target="_blank" rel="noopener" aria-label="فيسبوك"><i class="fab fa-facebook-f"></i></a>
                </div>
            </div>
            <div class="footer-col footer-commercial-reg">
                <h3><%= t.footer.commercialReg %></h3>
                <div class="commercial-reg-card">
                    <a href="/images/commercial-registration.png" target="_blank" rel="noopener" class="commercial-reg-link" title="<%= t.footer.commercialReg %>">
                        <img src="/images/commercial-registration.png" alt="<%= t.footer.commercialReg %>" class="commercial-reg-img" loading="lazy">
                    </a>
                    <div class="commercial-reg-info">
                        <span class="commercial-reg-label"><%= t.footerExtra.commercialRegNum %></span>
                        <span class="commercial-reg-num">2053033300</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p><%= t.footerExtra.rights %> &copy; 2026 <%= t.common.brandName %> - <%= t.common.brandEn %></p>
        </div>
    </footer>

    <!-- WhatsApp Floating Button -->
    <a href="https://wa.me/966502975175" class="whatsapp-float" target="_blank">
        <i class="fab fa-whatsapp"></i>
    </a>

    <script>window.__i18n = window.__i18n || {}; window.__i18n.sar = '<%= t.common.sar %>';</script>
    <script src="/js/main.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>"></script>
</body>
</html>