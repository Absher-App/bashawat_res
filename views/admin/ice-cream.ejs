<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>الآيسكريم - لوحة التحكم</title>
    <link rel="stylesheet" href="/css/admin.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>

    <%- include('partials/sidebar') %>

    <main class="main-content">
        
        <div class="header-title">
            <h2><i class="fas fa-ice-cream"></i> الآيسكريم</h2>
            <div class="user-info">
                <span>مرحباً، المشرف</span>
                <div class="user-avatar">A</div>
            </div>
        </div>

        <div class="content-grid">
            <div class="card" style="grid-column: span 2;">
                <div class="card-header">
                    <h3>أحجام الكوب والنكهات</h3>
                    <p style="color: #666; font-size: 0.95rem; margin-top: 8px;">حدد أحجام الكوب (صغير، وسط، كبير) مع السعر وعدد الكرات المسموح، ثم قائمة النكهات. العميل يختار الكوب أولاً ثم يضيف النكهات حسب العدد المسموح.</p>
                </div>
                <form action="/admin/icecream" method="POST" id="iceCreamForm">
                    <div class="form-group">
                        <label>أحجام الكوب (الاسم، السعر، عدد الكرات)</label>
                        <table class="admin-table" style="width: 100%; max-width: 500px;">
                            <thead>
                                <tr>
                                    <th>الحجم</th>
                                    <th>السعر (ر.س)</th>
                                    <th>عدد الكرات</th>
                                </tr>
                            </thead>
                            <tbody id="cupSizesBody">
                                <% (iceCreamOptions.cupSizes || []).forEach(function(cup, i) { %>
                                <tr>
                                    <td><input type="text" name="cup_name_<%= i %>" class="form-control" value="<%= cup.name_ar %>" placeholder="صغير"></td>
                                    <td><input type="number" name="cup_price_<%= i %>" class="form-control" value="<%= cup.price %>" min="0" step="0.01" placeholder="10"></td>
                                    <td><input type="number" name="cup_max_<%= i %>" class="form-control" value="<%= cup.max_scoops %>" min="1" max="10" placeholder="2"></td>
                                </tr>
                                <% }); %>
                                <% if (!iceCreamOptions.cupSizes || iceCreamOptions.cupSizes.length === 0) { %>
                                <tr>
                                    <td><input type="text" name="cup_name_0" class="form-control" value="صغير" placeholder="صغير"></td>
                                    <td><input type="number" name="cup_price_0" class="form-control" value="10" min="0" step="0.01"></td>
                                    <td><input type="number" name="cup_max_0" class="form-control" value="2" min="1" max="10"></td>
                                </tr>
                                <tr>
                                    <td><input type="text" name="cup_name_1" class="form-control" value="وسط" placeholder="وسط"></td>
                                    <td><input type="number" name="cup_price_1" class="form-control" value="15" min="0" step="0.01"></td>
                                    <td><input type="number" name="cup_max_1" class="form-control" value="3" min="1" max="10"></td>
                                </tr>
                                <tr>
                                    <td><input type="text" name="cup_name_2" class="form-control" value="كبير" placeholder="كبير"></td>
                                    <td><input type="number" name="cup_price_2" class="form-control" value="20" min="0" step="0.01"></td>
                                    <td><input type="number" name="cup_max_2" class="form-control" value="4" min="1" max="10"></td>
                                </tr>
                                <% } %>
                            </tbody>
                        </table>
                        <input type="hidden" name="cup_sizes_json" id="cupSizesJson" value="">
                    </div>
                    <div class="form-group" style="margin-top: 24px;">
                        <label>النكهات (كل سطر = نكهة)</label>
                        <textarea name="flavors" class="form-control" rows="14" placeholder="فانيلا&#10;رمان&#10;توت أسود&#10;بلوبيري&#10;ليمون&#10;شمام&#10;أمار بيري&#10;فراولة&#10;لوز قطيف&#10;ليمون نعناع&#10;تشيز كيك&#10;أوريو"><%= (iceCreamOptions.flavors || []).map(f => f.name_ar).join('\n') %></textarea>
                    </div>
                    <button type="submit" class="btn-primary" style="margin-top: 24px;">
                        <i class="fas fa-save"></i> حفظ الآيسكريم
                    </button>
                </form>
            </div>
        </div>

    </main>

    <script>
        document.getElementById('iceCreamForm').addEventListener('submit', function() {
            const rows = document.querySelectorAll('#cupSizesBody tr');
            const cupSizes = [];
            rows.forEach(function(tr) {
                const nameInput = tr.querySelector('input[name^="cup_name_"]');
                const priceInput = tr.querySelector('input[name^="cup_price_"]');
                const maxInput = tr.querySelector('input[name^="cup_max_"]');
                if (nameInput && priceInput && maxInput && nameInput.value.trim()) {
                    cupSizes.push({
                        name_ar: nameInput.value.trim(),
                        price: parseFloat(priceInput.value) || 0,
                        max_scoops: parseInt(maxInput.value, 10) || 2
                    });
                }
            });
            document.getElementById('cupSizesJson').value = JSON.stringify(cupSizes.length ? cupSizes : [
                { name_ar: 'صغير', price: 10, max_scoops: 2 },
                { name_ar: 'وسط', price: 15, max_scoops: 3 },
                { name_ar: 'كبير', price: 20, max_scoops: 4 }
            ]);

            const btn = this.querySelector('button[type="submit"]');
            if (btn) {
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الحفظ...';
                btn.disabled = true;
            }
        });
    </script>
</body>
</html>
