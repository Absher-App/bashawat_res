<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة السلايدر - لوحة التحكم</title>
    <link rel="stylesheet" href="/css/admin.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>

    <%- include('partials/sidebar') %>

    <main class="main-content">
        
        <div class="header-title">
            <h2>إدارة السلايدر</h2>
            <div class="user-info">
                <span>مرحباً، المشرف</span>
                <div class="user-avatar">A</div>
            </div>
        </div>

        <!-- Add Button Container -->
        <div class="add-btn-container">
            <button onclick="openModal('addSlideModal')" class="btn-add-new">
                <i class="fas fa-plus-circle"></i> إضافة سلايد جديد
            </button>
        </div>

        <div class="content-grid">
            <div class="card" style="grid-column: span 2;">
                <div class="card-header">
                    <h3>الشرائح الحالية</h3>
                </div>
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>الصورة</th>
                                <th>العنوان</th>
                                <th>العنوان الفرعي</th>
                                <th>الترتيب</th>
                                <th>إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% slides.forEach(slide => { %>
                            <tr>
                                <td>
                                    <img src="<%= slide.image_url %>" alt="<%= slide.title %>" class="product-img-sm">
                                </td>
                                <td><%= slide.title %></td>
                                <td><%= slide.subtitle %></td>
                                <td><%= slide.display_order %></td>
                                <td>
                                    <div class="action-btns">
                                        <button type="button" class="action-btn btn-edit-action" title="تعديل"
                                            onclick="openEditSlide(<%= slide.id %>)">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <form action="/admin/delete-slide/<%= slide.id %>" method="POST" style="display: inline;" onsubmit="return confirm('هل أنت متأكد من الحذف؟');">
                                            <button type="submit" class="action-btn" title="حذف"><i class="fas fa-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Add Slide Modal -->
        <div id="addSlideModal" class="admin-modal">
            <div class="modal-content">
                <span class="close-modal" onclick="closeModal('addSlideModal')">&times;</span>
                <div class="modal-header">
                    <h3>إضافة سلايد جديد</h3>
                </div>
                <form id="addSlideForm" action="/admin/add-slide" method="POST" enctype="multipart/form-data">
                    <div class="form-group">
                        <label>العنوان الرئيسي</label>
                        <input type="text" name="title" class="form-control" placeholder="عنوان الشريحة">
                    </div>
                    <div class="form-group">
                        <label>العنوان الفرعي</label>
                        <input type="text" name="subtitle" class="form-control" placeholder="وصف قصير">
                    </div>
                    <div class="form-group">
                        <label>رابط الزر (اختياري)</label>
                        <input type="text" name="link_url" class="form-control" placeholder="مثال: #products-section">
                    </div>
                    <div class="form-group">
                        <label>الترتيب</label>
                        <input type="number" name="display_order" class="form-control" value="0" placeholder="0">
                    </div>
                    <div class="form-group">
                        <label>الصورة</label>
                        <input type="file" name="image" accept="image/*" class="form-control" required>
                    </div>
                    <button id="addSlideBtn" type="submit" class="btn-primary">
                        <i class="fas fa-plus"></i> إضافة الشريحة
                    </button>
                </form>
            </div>
        </div>

        <!-- Edit Slide Modal -->
        <div id="editSlideModal" class="admin-modal">
            <div class="modal-content">
                <span class="close-modal" onclick="closeModal('editSlideModal')">&times;</span>
                <div class="modal-header">
                    <h3>تعديل الشريحة</h3>
                </div>
                <form id="editSlideForm" action="" method="POST" enctype="multipart/form-data">
                    <div class="form-group">
                        <label>العنوان الرئيسي</label>
                        <input type="text" name="title" id="editSlideTitle" class="form-control">
                    </div>
                    <div class="form-group">
                        <label>العنوان الفرعي</label>
                        <input type="text" name="subtitle" id="editSlideSubtitle" class="form-control">
                    </div>
                    <div class="form-group">
                        <label>رابط الزر (اختياري)</label>
                        <input type="text" name="link_url" id="editSlideLink" class="form-control">
                    </div>
                    <div class="form-group">
                        <label>الترتيب</label>
                        <input type="number" name="display_order" id="editSlideOrder" class="form-control">
                    </div>
                    <div class="form-group">
                        <label>صورة جديدة (اختياري - اتركه فارغاً للإبقاء على الصورة الحالية)</label>
                        <input type="file" name="image" accept="image/*" class="form-control">
                    </div>
                    <button id="editSlideBtn" type="submit" class="btn-primary">
                        <i class="fas fa-save"></i> حفظ التغييرات
                    </button>
                </form>
            </div>
        </div>

    </main>

    <script>
        const slidesData = { <% slides.forEach((s, i) => { %><%= s.id %>: <%- JSON.stringify({id:s.id,title:s.title||'',subtitle:s.subtitle||'',link_url:s.link_url||'',display_order:s.display_order||0}) %><%= i < slides.length-1 ? ',' : '' %><% }); %> };
        function openModal(id) {
            document.getElementById(id).classList.add('active');
        }
        function closeModal(id) {
            document.getElementById(id).classList.remove('active');
        }
        function openEditSlide(id) {
            const slide = slidesData[id];
            if (!slide) return;
            document.getElementById('editSlideForm').action = '/admin/update-slide/' + slide.id;
            document.getElementById('editSlideTitle').value = slide.title || '';
            document.getElementById('editSlideSubtitle').value = slide.subtitle || '';
            document.getElementById('editSlideLink').value = slide.link_url || '';
            document.getElementById('editSlideOrder').value = slide.display_order || 0;
            openModal('editSlideModal');
        }
        window.onclick = function(event) {
            if (event.target.classList.contains('admin-modal')) {
                event.target.classList.remove('active');
            }
        }
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') document.querySelectorAll('.admin-modal.active').forEach(m => m.classList.remove('active'));
        });

        // Loading State
        const form = document.getElementById('addSlideForm');
        const btn = document.getElementById('addSlideBtn');

        if(form) {
            form.addEventListener('submit', function() {
                if(form.checkValidity()) {
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الرفع...';
                    btn.disabled = true;
                }
            });
        }
        const editSlideForm = document.getElementById('editSlideForm');
        const editSlideBtn = document.getElementById('editSlideBtn');
        if(editSlideForm) {
            editSlideForm.addEventListener('submit', function() {
                editSlideBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الحفظ...';
                editSlideBtn.disabled = true;
            });
        }
    </script>

</body>
</html>
