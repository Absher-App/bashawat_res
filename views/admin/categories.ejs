<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة التصنيفات - لوحة التحكم</title>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>

    <%- include('partials/sidebar') %>

    <main class="main-content">
        
        <div class="header-title">
            <h2>إدارة التصنيفات</h2>
            <div class="user-info">
                <span>مرحباً، المشرف</span>
                <div class="user-avatar">A</div>
            </div>
        </div>

        <!-- Add Button Container -->
        <div class="add-btn-container">
            <button onclick="openModal('addCategoryModal')" class="btn-add-new">
                <i class="fas fa-plus-circle"></i> إضافة تصنيف جديد
            </button>
        </div>

        <div class="content-grid">
            <div class="card" style="grid-column: span 2;">
                <div class="card-header">
                    <h3>التصنيفات الحالية</h3>
                </div>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>اسم التصنيف</th>
                                <th>تاريخ الإضافة</th>
                                <th>إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% categories.forEach(cat => { %>
                            <tr>
                                <td><%= cat.name %></td>
                                <td><%= new Date(cat.created_at).toLocaleDateString('ar-EG') %></td>
                                <td>
                                    <form action="/admin/delete-category/<%= cat.id %>" method="POST" style="display: inline;" onsubmit="return confirm('هل أنت متأكد من الحذف؟ سيتم حذف جميع المنتجات المرتبطة بهذا التصنيف!');">
                                        <button type="submit" class="action-btn" title="حذف"><i class="fas fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Add Category Modal -->
        <div id="addCategoryModal" class="admin-modal">
            <div class="modal-content">
                <span class="close-modal" onclick="closeModal('addCategoryModal')">&times;</span>
                <div class="modal-header">
                    <h3>إضافة تصنيف جديد</h3>
                </div>
                <form id="addCategoryForm" action="/admin/add-category" method="POST">
                    <div class="form-group">
                        <label>اسم التصنيف</label>
                        <input type="text" name="name" class="form-control" required placeholder="مثال: بقلاوة">
                    </div>
                    <button id="addCategoryBtn" type="submit" class="btn-primary">
                        <i class="fas fa-plus"></i> إضافة التصنيف
                    </button>
                </form>
            </div>
        </div>

    </main>

    <script>
        function openModal(id) {
            document.getElementById(id).classList.add('active');
        }
        function closeModal(id) {
            document.getElementById(id).classList.remove('active');
        }
        // Close modal when clicking outside
        window.onclick = function(event) {
            if (event.target.classList.contains('admin-modal')) {
                event.target.classList.remove('active');
            }
        }

        // Loading State
        const form = document.getElementById('addCategoryForm');
        const btn = document.getElementById('addCategoryBtn');

        if(form) {
            form.addEventListener('submit', function() {
                if(form.checkValidity()) {
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الإضافة...';
                    btn.style.opacity = '0.7';
                    btn.style.pointerEvents = 'none';
                }
            });
        }
    </script>

</body>
</html>
