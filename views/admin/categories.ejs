<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة التصنيفات - لوحة التحكم</title>
    <link rel="stylesheet" href="/css/admin.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>

    <%- include('partials/sidebar') %>

    <main class="main-content">
        
        <div class="header-title">
            <h2>إدارة التصنيفات</h2>
            <div class="user-info">
                <span>مرحباً، المشرف</span>
                <div class="user-avatar">A</div>
            </div>
        </div>

        <!-- Add Button Container -->
        <div class="add-btn-container" style="display: flex; gap: 12px; flex-wrap: wrap;">
            <button onclick="openModal('addCategoryModal')" class="btn-add-new">
                <i class="fas fa-plus-circle"></i> إضافة تصنيف جديد
            </button>
            <button onclick="openModal('addCategoriesBulkModal')" class="btn-add-new" style="background: #3498db;">
                <i class="fas fa-layer-group"></i> إضافة عدة تصنيفات
            </button>
        </div>

        <div class="content-grid">
            <div class="card" style="grid-column: span 2;">
                <div class="card-header">
                    <h3>التصنيفات الحالية</h3>
                </div>
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>اسم التصنيف</th>
                                <th>تاريخ الإضافة</th>
                                <th>إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% categories.forEach(cat => { %>
                            <tr>
                                <td><%= cat.name %></td>
                                <td><%= new Date(cat.created_at).toLocaleDateString('ar-EG') %></td>
                                <td>
                                    <div class="action-btns">
                                        <button type="button" class="action-btn btn-edit-action" title="تعديل" 
                                            data-id="<%= cat.id %>" data-name="<%= (cat.name || '').replace(/&/g,'&amp;').replace(/"/g,'&quot;') %>"
                                            onclick="openEditCategory(this)">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <form action="/admin/delete-category/<%= cat.id %>" method="POST" style="display: inline;" onsubmit="return confirm('هل أنت متأكد من الحذف؟ سيتم حذف جميع المنتجات المرتبطة بهذا التصنيف!');">
                                            <button type="submit" class="action-btn" title="حذف"><i class="fas fa-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Add Category Modal -->
        <div id="addCategoryModal" class="admin-modal">
            <div class="modal-content">
                <span class="close-modal" onclick="closeModal('addCategoryModal')">&times;</span>
                <div class="modal-header">
                    <h3>إضافة تصنيف جديد</h3>
                </div>
                <form id="addCategoryForm" action="/admin/add-category" method="POST">
                    <div class="form-group">
                        <label>اسم التصنيف</label>
                        <input type="text" name="name" class="form-control" required placeholder="مثال: بقلاوة">
                    </div>
                    <button id="addCategoryBtn" type="submit" class="btn-primary">
                        <i class="fas fa-plus"></i> إضافة التصنيف
                    </button>
                </form>
            </div>
        </div>

        <!-- Add Multiple Categories Modal -->
        <div id="addCategoriesBulkModal" class="admin-modal">
            <div class="modal-content" style="max-width: 560px;">
                <span class="close-modal" onclick="closeModal('addCategoriesBulkModal')">&times;</span>
                <div class="modal-header">
                    <h3>إضافة عدة تصنيفات</h3>
                </div>
                <form id="addCategoriesBulkForm" action="/admin/add-categories-bulk" method="POST">
                    <div id="categoriesBulkRows">
                        <div class="bulk-row">
                            <input type="text" name="names[]" class="form-control" placeholder="اسم التصنيف">
                            <button type="button" class="bulk-remove-btn" onclick="removeBulkRow(this)" title="حذف"><i class="fas fa-times"></i></button>
                        </div>
                    </div>
                    <button type="button" class="btn-secondary" onclick="addBulkCategoryRow()" style="margin-bottom: 20px;">
                        <i class="fas fa-plus"></i> إضافة صف
                    </button>
                    <button id="addCategoriesBulkBtn" type="submit" class="btn-primary">
                        <i class="fas fa-check-double"></i> إضافة كل التصنيفات
                    </button>
                </form>
            </div>
        </div>

        <!-- Edit Category Modal -->
        <div id="editCategoryModal" class="admin-modal">
            <div class="modal-content">
                <span class="close-modal" onclick="closeModal('editCategoryModal')">&times;</span>
                <div class="modal-header">
                    <h3>تعديل التصنيف</h3>
                </div>
                <form id="editCategoryForm" action="" method="POST">
                    <div class="form-group">
                        <label>اسم التصنيف</label>
                        <input type="text" name="name" id="editCategoryName" class="form-control" required>
                    </div>
                    <button id="editCategoryBtn" type="submit" class="btn-primary">
                        <i class="fas fa-save"></i> حفظ التغييرات
                    </button>
                </form>
            </div>
        </div>

    </main>

    <script>
        function openModal(id) {
            document.getElementById(id).classList.add('active');
        }
        function closeModal(id) {
            document.getElementById(id).classList.remove('active');
        }
        function openEditCategory(btn) {
            const id = btn.dataset.id;
            const name = btn.dataset.name;
            document.getElementById('editCategoryForm').action = '/admin/update-category/' + id;
            document.getElementById('editCategoryName').value = name || '';
            openModal('editCategoryModal');
        }
        window.onclick = function(event) {
            if (event.target.classList.contains('admin-modal')) {
                event.target.classList.remove('active');
            }
        }
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') document.querySelectorAll('.admin-modal.active').forEach(m => m.classList.remove('active'));
        });

        function addBulkCategoryRow() {
            const container = document.getElementById('categoriesBulkRows');
            const div = document.createElement('div');
            div.className = 'bulk-row';
            div.innerHTML = '<input type="text" name="names[]" class="form-control" placeholder="اسم التصنيف">' +
                '<button type="button" class="bulk-remove-btn" onclick="removeBulkRow(this)" title="حذف"><i class="fas fa-times"></i></button>';
            container.appendChild(div);
        }
        function removeBulkRow(btn) {
            const rows = document.querySelectorAll('#categoriesBulkRows .bulk-row');
            if (rows.length <= 1) return;
            btn.closest('.bulk-row').remove();
        }

        // Loading State
        const form = document.getElementById('addCategoryForm');
        const btn = document.getElementById('addCategoryBtn');

        if(form) {
            form.addEventListener('submit', function() {
                if(form.checkValidity()) {
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الإضافة...';
                    btn.disabled = true;
                }
            });
        }
        const bulkCatForm = document.getElementById('addCategoriesBulkForm');
        const bulkCatBtn = document.getElementById('addCategoriesBulkBtn');
        if(bulkCatForm) {
            bulkCatForm.addEventListener('submit', function(e) {
                const filled = [...document.querySelectorAll('#categoriesBulkRows input[name="names[]"]')].filter(i => i.value.trim());
                if(filled.length === 0) {
                    e.preventDefault();
                    alert('أدخل اسماً واحداً على الأقل للتصنيف');
                    return;
                }
                bulkCatBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الإضافة...';
                bulkCatBtn.disabled = true;
            });
        }
        const editCatForm = document.getElementById('editCategoryForm');
        const editCatBtn = document.getElementById('editCategoryBtn');
        if(editCatForm) {
            editCatForm.addEventListener('submit', function() {
                editCatBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الحفظ...';
                editCatBtn.disabled = true;
            });
        }
    </script>

</body>
</html>
