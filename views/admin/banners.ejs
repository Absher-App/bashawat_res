<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>البانرات - لوحة التحكم</title>
    <link rel="stylesheet" href="/css/admin.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>

    <%- include('partials/sidebar') %>

    <main class="main-content">
        
        <div class="header-title">
            <h2>البانرات</h2>
            <div class="user-info">
                <span>مرحباً، المشرف</span>
                <div class="user-avatar">A</div>
            </div>
        </div>

        <div class="content-grid">
            <div class="card" style="grid-column: span 2;">
                <div class="card-header">
                    <h3><i class="fas fa-rectangle-ad"></i> بانر 1 و بانر 2</h3>
                    <p style="color: #666; font-size: 0.95rem; margin-top: 8px;">بانر 1: فيديو قصير (mp4 أو webm). بانر 2: صورة. يظهران في الصفحة الرئيسية تحت السلايدر.</p>
                </div>
                <form action="/admin/banners" method="POST" enctype="multipart/form-data">
                    <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
                        <div class="form-group">
                            <label>بانر 1 — فيديو قصير</label>
                            <% if (banner1) { %>
                            <div class="banner-preview" style="margin-bottom: 12px;">
                                <% const b1IsVideo = /\.(mp4|webm|ogg|mov)(\?|$)/i.test(banner1); %>
                                <% if (b1IsVideo) { %>
                                <video src="<%= banner1 %>" controls style="max-width: 100%; max-height: 200px; border-radius: 8px; border: 1px solid #ddd;"></video>
                                <% } else { %>
                                <img src="<%= banner1 %>" alt="بانر 1" style="max-width: 100%; max-height: 180px; object-fit: contain; border-radius: 8px; border: 1px solid #ddd;">
                                <% } %>
                            </div>
                            <% } %>
                            <input type="file" name="banner1" accept="video/mp4,video/webm,video/ogg,video/quicktime" class="form-control">
                        </div>
                        <div class="form-group">
                            <label>بانر 2 — صورة</label>
                            <% if (banner2) { %>
                            <div class="banner-preview" style="margin-bottom: 12px;">
                                <img src="<%= banner2 %>" alt="بانر 2" style="max-width: 100%; max-height: 180px; object-fit: contain; border-radius: 8px; border: 1px solid #ddd;">
                            </div>
                            <% } %>
                            <input type="file" name="banner2" accept="image/*" class="form-control">
                        </div>
                    </div>
                    <button type="submit" class="btn-primary" style="margin-top: 20px;">
                        <i class="fas fa-save"></i> حفظ البانرات
                    </button>
                </form>
            </div>
        </div>

    </main>

    <script>
        document.querySelector('form')?.addEventListener('submit', function() {
            const btn = this.querySelector('button[type="submit"]');
            if (btn) {
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الرفع...';
                btn.disabled = true;
            }
        });
    </script>
</body>
</html>
