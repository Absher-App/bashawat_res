<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>شريط العروض - لوحة التحكم</title>
    <link rel="stylesheet" href="/css/admin.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>

    <%- include('partials/sidebar') %>

    <main class="main-content">
        
        <div class="header-title">
            <h2>شريط العروض</h2>
            <div class="user-info">
                <span>مرحباً، المشرف</span>
                <div class="user-avatar">A</div>
            </div>
        </div>

        <div class="content-grid">
            <div class="card" style="grid-column: span 2;">
                <div class="card-header">
                    <h3>تحديث شريط العروض</h3>
                </div>
                <form id="offerForm" action="/admin/update-offer" method="POST">
                    <div class="form-group">
                        <label>نص العرض (يظهر أعلى الصفحة الرئيسية)</label>
                        <textarea name="offer_text" rows="4" class="form-control" placeholder="أدخل نص العرض هنا..."><%= offer_text %></textarea>
                        <small style="color: #666; margin-top: 5px; display: block;">
                            مثال: ✨ عروض حصرية لفترة محدودة! اطلب الآن واحصل على توصيل مجاني للطلبات فوق 200 ريال 🍰
                        </small>
                    </div>
                    <button id="saveOfferBtn" type="submit" class="btn-primary">
                        <i class="fas fa-save"></i> حفظ التغييرات
                    </button>
                </form>
            </div>
        </div>

    </main>

<script>
        document.getElementById('offerForm')?.addEventListener('submit', function() {
            const btn = document.getElementById('saveOfferBtn');
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الحفظ...';
            btn.disabled = true;
        });
    </script>
</body>
</html>
