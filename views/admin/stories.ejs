<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة القصص (Stories) - لوحة التحكم</title>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>

    <%- include('partials/sidebar') %>

    <main class="main-content">
        
        <div class="header-title">
            <h2>إدارة القصص (Stories)</h2>
            <div class="user-info">
                <span>مرحباً، المشرف</span>
                <div class="user-avatar">A</div>
            </div>
        </div>

        <!-- Add Button Container -->
        <div class="add-btn-container">
            <button onclick="openModal('addStoryModal')" class="btn-add-new">
                <i class="fas fa-plus-circle"></i> إضافة قصة جديدة
            </button>
        </div>

        <div class="content-grid">
            <div class="card" style="grid-column: span 2;">
                <div class="card-header">
                    <h3>القصص الحالية</h3>
                </div>
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>الغلاف</th>
                                <th>العنوان</th>
                                <th>الفيديو</th>
                                <th>تاريخ الإضافة</th>
                                <th>إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% stories.forEach(story => { %>
                            <tr>
                                <td>
                                    <img src="<%= story.cover_url %>" alt="<%= story.title %>" class="product-img-sm" style="border-radius: 50%; width: 50px; height: 50px; object-fit: cover;">
                                </td>
                                <td><%= story.title %></td>
                                <td>
                                    <a href="<%= story.video_url %>" target="_blank" class="btn-sm btn-info">
                                        <i class="fas fa-play"></i> مشاهدة
                                    </a>
                                </td>
                                <td><%= new Date(story.created_at).toLocaleDateString('ar-EG') %></td>
                                <td>
                                    <form action="/admin/delete-story/<%= story.id %>" method="POST" style="display: inline;" onsubmit="return confirm('هل أنت متأكد من حذف هذه القصة؟');">
                                        <button type="submit" class="action-btn" title="حذف"><i class="fas fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Add Story Modal -->
        <div id="addStoryModal" class="admin-modal">
            <div class="modal-content">
                <span class="close-modal" onclick="closeModal('addStoryModal')">&times;</span>
                <div class="modal-header">
                    <h3>إضافة قصة جديدة</h3>
                </div>
                <form action="/admin/add-story" method="POST" enctype="multipart/form-data">
                    <div class="form-group">
                        <label>عنوان القصة (يظهر أسفل الدائرة)</label>
                        <input type="text" name="title" class="form-control" placeholder="مثال: بقلاوة بالفستق" required>
                    </div>
                    <div class="form-group">
                        <label>صورة الغلاف (Cover Image)</label>
                        <input type="file" name="cover" accept="image/*" class="form-control" required>
                        <small style="color: #666;">ستظهر كأيقونة دائرية (يفضل أن تكون مربعة)</small>
                    </div>
                    <div class="form-group">
                        <label>ملف الفيديو</label>
                        <input type="file" name="video" accept="video/*" class="form-control" required>
                        <small style="color: #666;">يفضل فيديو عمودي قصير (مثل Instagram Stories)</small>
                    </div>
                    <button type="submit" class="btn-primary">
                        <i class="fas fa-plus"></i> إضافة القصة
                    </button>
                </form>
            </div>
        </div>

    </main>

    <script>
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') document.querySelectorAll('.admin-modal.active').forEach(m => m.classList.remove('active'));
        });
        function openModal(id) {
            document.getElementById(id).classList.add('active');
        }
        function closeModal(id) {
            document.getElementById(id).classList.remove('active');
        }
        // Close modal when clicking outside
        window.onclick = function(event) {
            if (event.target.classList.contains('admin-modal')) {
                event.target.classList.remove('active');
            }
        }
    </script>

</body>
</html>
