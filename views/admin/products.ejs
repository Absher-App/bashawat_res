<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة المنتجات - لوحة التحكم</title>
    <link rel="stylesheet" href="/css/admin.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>

    <%- include('partials/sidebar') %>

    <main class="main-content">
        
        <div class="header-title">
            <h2>إدارة المنتجات</h2>
            <div class="user-info">
                <span>مرحباً، المشرف</span>
                <div class="user-avatar">A</div>
            </div>
        </div>

        <!-- Add Button Container -->
        <div class="add-btn-container" style="display: flex; gap: 12px; flex-wrap: wrap;">
            <button onclick="openModal('addProductModal')" class="btn-add-new">
                <i class="fas fa-plus-circle"></i> إضافة منتج جديد
            </button>
            <button onclick="openModal('addProductsBulkModal')" class="btn-add-new" style="background: #3498db;">
                <i class="fas fa-layer-group"></i> إضافة عدة منتجات
            </button>
        </div>

        <div class="content-grid">
            <div class="card" style="grid-column: span 2;">
                <div class="card-header">
                    <h3>قائمة المنتجات</h3>
                </div>
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>الصورة</th>
                                <th>الاسم</th>
                                <th>السعر</th>
                                <th>التصنيف</th>
                                <th>إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% products.forEach(product => { %>
                            <tr>
                                <td>
                                    <% if(product.image_url) { %>
                                        <img src="<%= product.image_url %>" alt="<%= product.name %>" class="product-img-sm">
                                    <% } else { %>
                                        <span class="product-img-sm" style="background:#eee;display:inline-flex;align-items:center;justify-content:center;color:#999;"><i class="fas fa-image"></i></span>
                                    <% } %>
                                </td>
                                <td><%= product.name %></td>
                                <td><%= product.price %> ريال</td>
                                <td><%= product.category %></td>
                                <td>
                                    <div class="action-btns">
                                        <button type="button" class="action-btn btn-edit-action" title="تعديل" 
                                            data-id="<%= product.id %>"
                                            onclick="openEditProduct(<%= product.id %>)">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <form action="/admin/delete-product/<%= product.id %>" method="POST" style="display: inline;" onsubmit="return confirm('هل أنت متأكد من الحذف؟');">
                                            <button type="submit" class="action-btn" title="حذف"><i class="fas fa-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Add Product Modal -->
        <div id="addProductModal" class="admin-modal">
            <div class="modal-content">
                <span class="close-modal" onclick="closeModal('addProductModal')">&times;</span>
                <div class="modal-header">
                    <h3>إضافة منتج جديد</h3>
                </div>
                <form id="addProductForm" action="/admin/add-product" method="POST" enctype="multipart/form-data">
                    <div class="form-group">
                        <label>اسم المنتج</label>
                        <input type="text" name="name" class="form-control" required placeholder="أدخل اسم المنتج">
                    </div>
                    <div class="form-group">
                        <label>الوصف</label>
                        <textarea name="description" class="form-control" rows="3" placeholder="وصف قصير للمنتج"></textarea>
                    </div>
                    <div class="form-group">
                        <label>تفاصيل المنتج</label>
                        <textarea name="details" class="form-control" rows="4" placeholder="تفاصيل إضافية تظهر عند تمرير الماوس: المكونات، الحجم، المعلومات الغذائية، إلخ"></textarea>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>السعر (ريال)</label>
                            <input type="number" name="price" class="form-control" step="0.01" required placeholder="0.00">
                        </div>
                        <div class="form-group">
                            <label>التصنيف</label>
                            <select name="category" class="form-control" required>
                                <% if (categories && categories.length > 0) { %>
                                    <% categories.forEach(cat => { %>
                                        <option value="<%= cat.name %>"><%= cat.name %></option>
                                    <% }); %>
                                <% } else { %>
                                    <option value="" disabled selected>أضف تصنيفاً أولاً</option>
                                <% } %>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>صور المنتج (يمكن إضافة أكثر من صورة)</label>
                        <input type="file" name="images" accept="image/*" class="form-control" multiple required>
                        <small class="form-text text-muted">اختر صورة واحدة أو عدة صور (حتى 10)</small>
                    </div>
                    <div class="form-group checkbox-group">
                        <label class="checkbox-label">
                            <input type="checkbox" name="is_cake" value="1">
                            <span>منتج كيك (يظهر نموذج التفاصيل عند الطلب)</span>
                        </label>
                    </div>
                    <div class="form-group variants-section">
                        <label class="checkbox-label">
                            <input type="checkbox" name="has_variants" id="addHasVariants" value="1" onchange="toggleVariants('add', this.checked)">
                            <span>يوجد أحجام أو أوزان بأسعار مختلفة</span>
                        </label>
                        <div id="addVariantsBox" class="variants-box" style="display:none;">
                            <div class="form-group">
                                <label>نوع الخيار</label>
                                <select name="variant_type" id="addVariantType" class="form-control">
                                    <option value="size">أحجام (للكيك)</option>
                                    <option value="weight">أوزان (للحلويات)</option>
                                </select>
                            </div>
                            <div class="variants-rows" id="addVariantsRows">
                                <div class="variant-row">
                                    <input type="text" name="variant_names[]" placeholder="مثال: صغير" class="form-control">
                                    <input type="number" name="variant_prices[]" step="0.01" placeholder="السعر" class="form-control">
                                    <button type="button" class="btn-remove-variant" onclick="removeVariantRow(this)">&times;</button>
                                </div>
                            </div>
                            <button type="button" class="btn-add-variant" onclick="addVariantRow('add')"><i class="fas fa-plus"></i> إضافة خيار</button>
                        </div>
                    </div>
                    <input type="hidden" name="variants_json" id="addVariantsJson">
                    <button id="addProductBtn" type="submit" class="btn-primary">
                        <i class="fas fa-plus"></i> إضافة المنتج
                    </button>
                </form>
            </div>
        </div>

        <!-- Add Multiple Products Modal -->
        <div id="addProductsBulkModal" class="admin-modal">
            <div class="modal-content" style="max-width: 700px; max-height: 90vh; overflow-y: auto;">
                <span class="close-modal" onclick="closeModal('addProductsBulkModal')">&times;</span>
                <div class="modal-header">
                    <h3>إضافة عدة منتجات</h3>
                </div>
                <form id="addProductsBulkForm" action="/admin/add-products-bulk" method="POST" enctype="multipart/form-data">
                    <div id="productsBulkRows">
                        <div class="bulk-product-row">
                            <div class="bulk-product-num">1</div>
                            <input type="text" name="names[]" class="form-control" placeholder="اسم المنتج" required>
                            <input type="number" name="prices[]" class="form-control" step="0.01" placeholder="السعر" required style="max-width:100px;">
                            <select name="categories[]" class="form-control" required style="max-width:140px;">
                                <% if (categories && categories.length > 0) { %>
                                    <% categories.forEach(cat => { %>
                                        <option value="<%= cat.name %>"><%= cat.name %></option>
                                    <% }); %>
                                <% } else { %>
                                    <option value="">أضف تصنيفاً</option>
                                <% } %>
                            </select>
                            <input type="file" name="images" accept="image/*" class="form-control" required style="max-width:180px;">
                            <textarea name="descriptions[]" class="form-control" rows="1" placeholder="الوصف" style="flex:1;min-width:120px;"></textarea>
                            <textarea name="details[]" class="form-control" rows="1" placeholder="التفاصيل" style="flex:1;min-width:120px;"></textarea>
                            <label class="bulk-cake-check"><input type="checkbox" name="is_cake_0" value="1"> كيك</label>
                            <button type="button" class="bulk-remove-btn" onclick="removeBulkProductRow(this)" title="حذف"><i class="fas fa-times"></i></button>
                        </div>
                    </div>
                    <button type="button" class="btn-secondary" onclick="addBulkProductRow()" style="margin-bottom: 20px;">
                        <i class="fas fa-plus"></i> إضافة منتج آخر
                    </button>
                    <button id="addProductsBulkBtn" type="submit" class="btn-primary">
                        <i class="fas fa-check-double"></i> إضافة كل المنتجات
                    </button>
                </form>
            </div>
        </div>

        <!-- Edit Product Modal -->
        <div id="editProductModal" class="admin-modal">
            <div class="modal-content">
                <span class="close-modal" onclick="closeModal('editProductModal')">&times;</span>
                <div class="modal-header">
                    <h3>تعديل المنتج</h3>
                </div>
                <form id="editProductForm" action="" method="POST" enctype="multipart/form-data">
                    <div class="form-group">
                        <label>اسم المنتج</label>
                        <input type="text" name="name" id="editProductName" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>الوصف</label>
                        <textarea name="description" id="editProductDesc" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="form-group">
                        <label>تفاصيل المنتج</label>
                        <textarea name="details" id="editProductDetails" class="form-control" rows="4" placeholder="تفاصيل إضافية تظهر عند تمرير الماوس"></textarea>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>السعر (ريال)</label>
                            <input type="number" name="price" id="editProductPrice" class="form-control" step="0.01" required>
                        </div>
                        <div class="form-group">
                            <label>التصنيف</label>
                            <select name="category" id="editProductCategory" class="form-control" required>
                                <% if (categories && categories.length > 0) { %>
                                    <% categories.forEach(cat => { %>
                                        <option value="<%= cat.name %>"><%= cat.name %></option>
                                    <% }); %>
                                <% } %>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>صور المنتج الحالية</label>
                        <div id="editProductImagesList" class="product-images-thumbs"></div>
                        <input type="hidden" name="existing_images" id="editExistingImages">
                    </div>
                    <div class="form-group">
                        <label>صورة الغلاف الجديدة (اختياري - لاستبدال الصورة الرئيسية)</label>
                        <input type="file" name="image" accept="image/*" class="form-control">
                    </div>
                    <div class="form-group">
                        <label>إضافة صور إضافية (اختياري)</label>
                        <input type="file" name="images" accept="image/*" class="form-control" multiple>
                    </div>
                    <div class="form-group checkbox-group">
                        <label class="checkbox-label">
                            <input type="checkbox" name="is_cake" value="1" id="editProductIsCake">
                            <span>منتج كيك (يظهر نموذج التفاصيل عند الطلب)</span>
                        </label>
                    </div>
                    <div class="form-group variants-section">
                        <label class="checkbox-label">
                            <input type="checkbox" name="has_variants" id="editHasVariants" value="1" onchange="toggleVariants('edit', this.checked)">
                            <span>يوجد أحجام أو أوزان بأسعار مختلفة</span>
                        </label>
                        <div id="editVariantsBox" class="variants-box" style="display:none;">
                            <div class="form-group">
                                <label>نوع الخيار</label>
                                <select name="variant_type" id="editVariantType" class="form-control">
                                    <option value="size">أحجام (للكيك)</option>
                                    <option value="weight">أوزان (للحلويات)</option>
                                </select>
                            </div>
                            <div class="variants-rows" id="editVariantsRows"></div>
                            <button type="button" class="btn-add-variant" onclick="addVariantRow('edit')"><i class="fas fa-plus"></i> إضافة خيار</button>
                        </div>
                    </div>
                    <input type="hidden" name="variants_json" id="editVariantsJson">
                    <button id="editProductBtn" type="submit" class="btn-primary">
                        <i class="fas fa-save"></i> حفظ التغييرات
                    </button>
                </form>
            </div>
        </div>

    </main>

    <script>
        const productsData = { <% products.forEach((p, i) => { 
            let imgs = [];
            try { imgs = p.images ? (typeof p.images==='string' ? JSON.parse(p.images) : p.images) : []; } catch(e){}
            if (!imgs.length && p.image_url) imgs = [p.image_url];
            let vars = [];
            try { vars = p.variants ? (typeof p.variants==='string' ? JSON.parse(p.variants) : p.variants) : []; } catch(e){}
        %><%= p.id %>: <%- JSON.stringify({id:p.id,name:p.name,description:p.description||'',details:p.details||'',price:p.price,category:p.category||'',image_url:p.image_url||'',images:imgs,variant_type:p.variant_type||'',variants:vars,is_cake:!!p.is_cake}) %><%= i < products.length-1 ? ',' : '' %><% }); %> };
        function openModal(id) {
            document.getElementById(id).classList.add('active');
        }
        function closeModal(id) {
            document.getElementById(id).classList.remove('active');
        }
        let currentEditImages = [];
        function openEditProduct(id) {
            const product = productsData[id];
            if (!product) return;
            document.getElementById('editProductForm').action = '/admin/update-product/' + product.id;
            document.getElementById('editProductName').value = product.name;
            document.getElementById('editProductDesc').value = product.description || '';
            document.getElementById('editProductDetails').value = product.details || '';
            document.getElementById('editProductIsCake').checked = product.is_cake || false;
            document.getElementById('editProductPrice').value = product.price;
            document.getElementById('editProductCategory').value = product.category || '';
            currentEditImages = Array.isArray(product.images) ? [...product.images] : (product.image_url ? [product.image_url] : []);
            renderEditImages();
            document.querySelector('#editProductModal input[name="image"]').value = '';
            document.querySelector('#editProductModal input[name="images"]').value = '';

            document.getElementById('editHasVariants').checked = product.variants && product.variants.length > 0;
            toggleVariants('edit', product.variants && product.variants.length > 0);
            document.getElementById('editVariantType').value = product.variant_type || 'size';
            const editRows = document.getElementById('editVariantsRows');
            editRows.innerHTML = '';
            if (product.variants && product.variants.length) {
                product.variants.forEach(v => {
                    const row = document.createElement('div');
                    row.className = 'variant-row';
                    row.innerHTML = '<input type="text" name="variant_names[]" placeholder="الاسم" value="' + (v.name || '').replace(/"/g,'&quot;') + '" class="form-control">' +
                        '<input type="number" name="variant_prices[]" step="0.01" placeholder="السعر" value="' + (v.price || '') + '" class="form-control">' +
                        '<button type="button" class="btn-remove-variant" onclick="removeVariantRow(this)">&times;</button>';
                    editRows.appendChild(row);
                });
            } else {
                addVariantRow('edit');
            }

            openModal('editProductModal');
        }
        function toggleVariants(prefix, show) {
            const box = document.getElementById(prefix + 'VariantsBox');
            box.style.display = show ? 'block' : 'none';
        }
        function addVariantRow(prefix) {
            const container = document.getElementById(prefix + 'VariantsRows');
            const row = document.createElement('div');
            row.className = 'variant-row';
            row.innerHTML = '<input type="text" name="variant_names[]" placeholder="مثال: صغير أو نصف كيلو" class="form-control">' +
                '<input type="number" name="variant_prices[]" step="0.01" placeholder="السعر" class="form-control">' +
                '<button type="button" class="btn-remove-variant" onclick="removeVariantRow(this)">&times;</button>';
            container.appendChild(row);
        }
        function removeVariantRow(btn) {
            const rows = btn.closest('.variants-rows').querySelectorAll('.variant-row');
            if (rows.length <= 1) return;
            btn.closest('.variant-row').remove();
        }
        function renderEditImages() {
            const list = document.getElementById('editProductImagesList');
            document.getElementById('editExistingImages').value = JSON.stringify(currentEditImages);
            list.innerHTML = currentEditImages.map((url, i) => `
                <span class="product-img-thumb">
                    <img src="${url}" alt="">
                    <button type="button" class="remove-img-btn" onclick="removeEditImage(${i})" title="حذف">&times;</button>
                </span>
            `).join('') || '<span class="no-images-msg">لا توجد صور</span>';
        }
        function removeEditImage(idx) {
            currentEditImages.splice(idx, 1);
            renderEditImages();
        }
        window.onclick = function(event) {
            if (event.target.classList.contains('admin-modal')) {
                event.target.classList.remove('active');
            }
        }
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                document.querySelectorAll('.admin-modal.active').forEach(m => m.classList.remove('active'));
            }
        });

        function addBulkProductRow() {
            const container = document.getElementById('productsBulkRows');
            const rows = container.querySelectorAll('.bulk-product-row');
            const firstRow = rows[0];
            const clone = firstRow.cloneNode(true);
            clone.querySelectorAll('input, textarea, select').forEach(el => {
                if (el.type === 'file') el.value = '';
                else if (el.type === 'checkbox') el.checked = false;
                else if (el.tagName === 'SELECT') el.selectedIndex = 0;
                else el.value = '';
            });
            const newIdx = rows.length;
            clone.querySelector('.bulk-product-num').textContent = newIdx + 1;
            const cakeCb = clone.querySelector('.bulk-cake-check input');
            if (cakeCb) cakeCb.name = 'is_cake_' + newIdx;
            container.appendChild(clone);
        }
        function removeBulkProductRow(btn) {
            const rows = document.querySelectorAll('#productsBulkRows .bulk-product-row');
            if (rows.length <= 1) return;
            btn.closest('.bulk-product-row').remove();
        }

        // Loading State
        const form = document.getElementById('addProductForm');
        const btn = document.getElementById('addProductBtn');

        if(form) {
            form.addEventListener('submit', function() {
                if (document.getElementById('addHasVariants').checked) {
                    const rows = document.querySelectorAll('#addVariantsRows .variant-row');
                    const vars = [];
                    rows.forEach(r => {
                        const name = (r.querySelector('input[name="variant_names[]"]') || {}).value;
                        const price = parseFloat((r.querySelector('input[name="variant_prices[]"]') || {}).value);
                        if (name && !isNaN(price)) vars.push({name: name.trim(), price});
                    });
                    document.getElementById('addVariantsJson').value = JSON.stringify(vars);
                } else {
                    document.getElementById('addVariantsJson').value = '';
                }
                if(form.checkValidity()) {
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الرفع...';
                    btn.disabled = true;
                }
            });
        }
        const bulkProdForm = document.getElementById('addProductsBulkForm');
        const bulkProdBtn = document.getElementById('addProductsBulkBtn');
        if(bulkProdForm) {
            bulkProdForm.addEventListener('submit', function() {
                if(bulkProdForm.checkValidity()) {
                    bulkProdBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الرفع...';
                    bulkProdBtn.disabled = true;
                }
            });
        }
        const editForm = document.getElementById('editProductForm');
        const editBtn = document.getElementById('editProductBtn');
        if(editForm) {
            editForm.addEventListener('submit', function() {
                if (document.getElementById('editHasVariants').checked) {
                    const rows = document.querySelectorAll('#editVariantsRows .variant-row');
                    const vars = [];
                    rows.forEach(r => {
                        const name = (r.querySelector('input[name="variant_names[]"]') || {}).value;
                        const price = parseFloat((r.querySelector('input[name="variant_prices[]"]') || {}).value);
                        if (name && !isNaN(price)) vars.push({name: name.trim(), price});
                    });
                    document.getElementById('editVariantsJson').value = JSON.stringify(vars);
                } else {
                    document.getElementById('editVariantsJson').value = '';
                }
                if(editForm.checkValidity()) {
                    editBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الحفظ...';
                    editBtn.disabled = true;
                }
            });
        }
    </script>

</body>
</html>
