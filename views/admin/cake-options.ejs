<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>خيارات الكيك - لوحة التحكم</title>
    <link rel="stylesheet" href="/css/admin.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>

    <%- include('partials/sidebar') %>

    <main class="main-content">
        
        <div class="header-title">
            <h2>خيارات الكيك</h2>
            <div class="user-info">
                <span>مرحباً، المشرف</span>
                <div class="user-avatar">A</div>
            </div>
        </div>

        <div class="content-grid">
            <div class="card" style="grid-column: span 2;">
                <div class="card-header">
                    <h3><i class="fas fa-birthday-cake"></i> القيم التي تظهر للعميل عند طلب كيك</h3>
                    <p style="color: #666; font-size: 0.95rem; margin-top: 8px;">اكتب كل خيار في سطر مستقل. هذه القيم تظهر في قوائم (الأحجام، الكيك سبونج، الحشوة، الإضافة) عند إضافة منتج كيك للسلة.</p>
                </div>
                <form action="/admin/cake-options" method="POST">
                    <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
                        <div class="form-group">
                            <label>الأحجام</label>
                            <textarea name="sizes" class="form-control" rows="6" placeholder="صغير&#10;وسط&#10;كبير"><%= (cakeOptions.sizes && cakeOptions.sizes.length) ? cakeOptions.sizes.join('\n') : 'صغير\nوسط\nكبير' %></textarea>
                            <small class="form-text text-muted">كل سطر = خيار واحد</small>
                        </div>
                        <div class="form-group">
                            <label>الكيك سبونج</label>
                            <textarea name="sponge" class="form-control" rows="6" placeholder="فانيلا&#10;شوكولاتة&#10;مشمش"><%= (cakeOptions.sponge && cakeOptions.sponge.length) ? cakeOptions.sponge.join('\n') : 'فانيلا\nشوكولاتة\nمشمش' %></textarea>
                            <small class="form-text text-muted">كل سطر = خيار واحد</small>
                        </div>
                    </div>
                    <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 20px;">
                        <div class="form-group">
                            <label>الحشوة من الداخل</label>
                            <textarea name="filling" class="form-control" rows="6" placeholder="كريمة&#10;شوكولاتة&#10;فراولة"><%= (cakeOptions.filling && cakeOptions.filling.length) ? cakeOptions.filling.join('\n') : 'كريمة\nشوكولاتة\nفراولة' %></textarea>
                            <small class="form-text text-muted">كل سطر = خيار واحد</small>
                        </div>
                        <div class="form-group">
                            <label>الإضافة</label>
                            <textarea name="addon" class="form-control" rows="6" placeholder="بدون&#10;فراولة&#10;شوكولاتة"><%= (cakeOptions.addon && cakeOptions.addon.length) ? cakeOptions.addon.join('\n') : 'بدون\nفراولة\nشوكولاتة' %></textarea>
                            <small class="form-text text-muted">كل سطر = خيار واحد</small>
                        </div>
                    </div>
                    <button type="submit" class="btn-primary" style="margin-top: 24px;">
                        <i class="fas fa-save"></i> حفظ خيارات الكيك
                    </button>
                </form>
            </div>
        </div>

    </main>

    <script>
        document.querySelector('form')?.addEventListener('submit', function() {
            const btn = this.querySelector('button[type="submit"]');
            if (btn) {
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الحفظ...';
                btn.disabled = true;
            }
        });
    </script>
</body>
</html>
