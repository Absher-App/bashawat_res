<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>حلويات بقداش - Bagdash sweets | حلويات القطيف وسيهات</title>
    <meta name="description" content="حلويات بقداش - أفضل حلويات عربية وكيك في القطيف وسيهات والدمام. طلب أونلاين وتوصيل. كنافة، بقلاوة، بسبوسة، كيك مناسبات.">
    <meta name="keywords" content="حلويات بقداش، بقداش، حلويات القطيف، حلويات سيهات، حلويات الدمام، كيك قطيف، حلويات عربية، كنافة، بقلاوة، توصيل حلويات">
    <meta name="author" content="حلويات بقداش">
    <% if (typeof siteUrl !== 'undefined' && siteUrl) { %>
    <link rel="canonical" href="<%= siteUrl %>/">
    <meta property="og:url" content="<%= siteUrl %>/">
    <% } %>
    <meta property="og:type" content="website">
    <meta property="og:title" content="حلويات بقداش - Bagdash sweets | حلويات القطيف وسيهات">
    <meta property="og:description" content="أفضل حلويات عربية وكيك في القطيف وسيهات. طلب أونلاين وتوصيل.">
    <meta property="og:locale" content="ar_SA">
    <meta property="og:image" content="<%= typeof siteUrl !== 'undefined' && siteUrl ? siteUrl : '' %>/images/logo.png">
    <link rel="stylesheet" href="/css/style.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700&display=swap" rel="stylesheet">
    <!-- إضافة أيقونات Font Awesome للسلة -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <!-- Header: شريط العروض + التوبار -->
    <header class="site-header">
        <div class="offers-banner">
            <div class="offers-marquee-wrap" aria-hidden="true">
                <span class="offers-text"><%= offer_text || '✨ توصيل مجاني للطلبات فوق 200 ريال — عروض حصرية لفترة محدودة' %></span>
                <span class="offers-text"><%= offer_text || '✨ توصيل مجاني للطلبات فوق 200 ريال — عروض حصرية لفترة محدودة' %></span>
            </div>
        </div>
        <nav class="topbar">
            <div class="container topbar-content">
                <a href="/" class="logo-area">
                    <img src="/images/logo.png" alt="حلويات بقداش" class="nav-logo">
                    <span class="brand-name">حلويات بقداش <em class="brand-en">Bagdash sweets</em></span>
                </a>
                <ul class="nav-links">
                    <li><a href="/" class="nav-link active">الرئيسية</a></li>
                    <li><a href="/products" class="nav-link">المنتجات</a></li>
                    <li><a href="/parties" class="nav-link">الحفلات</a></li>
                    <li><a href="/cart" class="nav-link nav-cart">السلة <i class="fas fa-shopping-cart"></i></a></li>
                </ul>
                <div class="topbar-social">
                    <a href="https://www.instagram.com/bodatbagdash/" target="_blank" rel="noopener" aria-label="انستغرام"><i class="fab fa-instagram"></i></a>
                    <a href="https://twitter.com" target="_blank" rel="noopener" aria-label="تويتر"><i class="fab fa-twitter"></i></a>
                    <a href="https://snapchat.com" target="_blank" rel="noopener" aria-label="سناب شات"><i class="fab fa-snapchat-ghost"></i></a>
                    <a href="https://facebook.com" target="_blank" rel="noopener" aria-label="فيسبوك"><i class="fab fa-facebook-f"></i></a>
                </div>
            </div>
        </nav>
    </header>

    <!-- زر السلة العائم -->
    <a href="/cart" class="cart-floating-btn" id="cartBtn">
        <i class="fas fa-shopping-cart"></i>
        <span class="cart-count" id="cartCount">0</span>
    </a>

    <!-- قسم السلايدر -->
    <section class="hero-slider">
        <div class="slider-container">
            <% if (slides && slides.length > 0) { %>
                <% slides.forEach((slide, index) => { %>
                <div class="slide <%= index === 0 ? 'active' : '' %>" style="background-image: url('<%= slide.image_url %>');">
                    <div class="slide-content">
                        <% if(slide.title) { %><h2><%= slide.title %></h2><% } %>
                        <% if(slide.subtitle) { %><p><%= slide.subtitle %></p><% } %>
                        <% if(slide.link_url) { %>
                            <a href="<%= slide.link_url %>" class="cta-btn">تصفح المزيد</a>
                        <% } %>
                    </div>
                </div>
                <% }); %>
            <% } else { %>
                <!-- Default Slide if no slides in DB -->
                <div class="slide active" style="background-image: url('https://images.unsplash.com/photo-1579372786545-d24232daf58c?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80');">
                    <div class="slide-content">
                        <h2>أشهى الحلويات العربية</h2>
                        <p>طعم الأصالة في كل قطعة</p>
                        <a href="#products-section" class="cta-btn">تصفح القائمة</a>
                    </div>
                </div>
            <% } %>
            
            <button class="prev-slide">&#10094;</button>
            <button class="next-slide">&#10095;</button>
        </div>
    </section>

    <!-- قسم الستوريات / الفيديوهات -->
    <% if (stories && stories.length > 0) { %>
    <section class="stories-section">
        <div class="container">
            <div class="stories-scroll-wrapper">
                <div class="stories-scroll-container">
                    <% stories.forEach(function(story) { %>
                    <div class="story-item" onclick="openStoryModal('<%= story.video_url %>', '<%= story.title %>')">
                        <div class="story-circle">
                            <img src="<%= story.cover_url %>" alt="<%= story.title %>">
                        </div>
                        <span class="story-title"><%= story.title || 'ستوري' %></span>
                    </div>
                    <% }); %>
                </div>
            </div>
        </div>
    </section>
    <!-- مودال عرض الفيديو -->
    <div class="story-video-modal" id="storyVideoModal" onclick="closeStoryModal(event)">
        <button class="story-modal-close" onclick="closeStoryModal(event)">&times;</button>
        <div class="story-modal-content" onclick="event.stopPropagation()">
            <h3 class="story-modal-title" id="storyModalTitle"></h3>
            <video id="storyVideoPlayer" controls playsinline></video>
        </div>
    </div>
    <% } %>

    <!-- قسم الأكثر طلباً -->
    <% const _mostRequested = (typeof mostRequestedProducts !== 'undefined' && mostRequestedProducts) ? mostRequestedProducts : []; %>
    <% if (_mostRequested.length > 0) { %>
    <section class="most-requested-section">
        <div class="container">
            <div class="most-requested-header">
                <span class="most-requested-badge"><i class="fas fa-fire"></i> الأكثر طلباً</span>
                <h2 class="most-requested-title">المنتجات الأكثر طلباً</h2>
                <p class="most-requested-desc">اختر من بين الأصناف الأكثر إقبالاً من زبائننا</p>
            </div>
            <div class="products-grid most-requested-grid">
                <% _mostRequested.forEach(function(product) { %>
                <div class="product-card product-has-hover" data-id="<%= product.id %>">
                    <div class="product-image">
                        <img src="<%= (product.images && product.images[0]) || product.image_url || 'https://via.placeholder.com/600x400?text=No+Image' %>" alt="<%= product.name %>" loading="lazy">
                        <span class="price"><% if (product.sale_price != null && product.sale_price !== '' && (!product.variants || !product.variants.length)) { %><span class="price-old"><%= product.price %> ر.س</span> <span class="price-sale"><%= product.sale_price %> ر.س</span><% } else { %><%= (product.variants && product.variants.length) ? ('من ' + Math.min(...product.variants.map(v=>parseFloat(v.price)||0)) + ' ر.س') : (product.price + ' ر.س') %><% } %></span>
                    </div>
                    <div class="product-info">
                        <h3><%= product.name %></h3>
                        <p><%= product.description %></p>
                        <div class="product-actions">
                            <button class="order-btn add-to-cart-btn" onclick="addToCart(<%= JSON.stringify(product) %>)">
                                <i class="fas fa-cart-plus"></i> أضف للسلة
                            </button>
                            <div class="qty-control-widget" style="display: none;">
                                <button class="qty-btn minus" onclick="updateItemQty(<%= product.id %>, -1)"><i class="fas fa-minus"></i></button>
                                <span class="qty-display">1</span>
                                <button class="qty-btn plus" onclick="updateItemQty(<%= product.id %>, 1)"><i class="fas fa-plus"></i></button>
                            </div>
                        </div>
                    </div>
                    <div class="product-hover-card">
                        <div class="hover-card-content">
                            <div class="hover-card-header">
                                <img src="<%= (product.images && product.images[0]) || product.image_url || 'https://via.placeholder.com/600x400?text=No+Image' %>" alt="<%= product.name %>" class="hover-card-img">
                                <div class="hover-card-title-block">
                                    <h4><%= product.name %></h4>
                                    <span class="hover-category"><i class="fas fa-tag"></i> <%= product.category %></span>
                                </div>
                            </div>
                            <p class="hover-desc"><%= product.description || '—' %></p>
                            <% if (product.details && product.details.trim()) { %>
                            <div class="hover-details-block">
                                <span class="hover-details-label"><i class="fas fa-info-circle"></i> التفاصيل</span>
                                <p class="hover-details"><%= product.details %></p>
                            </div>
                            <% } %>
                            <% if (product.variants && product.variants.length > 0) { %>
                            <div class="hover-variants-block">
                                <span class="hover-details-label"><i class="fas fa-<%= product.variant_type === 'weight' ? 'weight-hanging' : 'ruler-combined' %>"></i> <%= product.variant_type === 'weight' ? 'الأوزان' : 'الأحجام' %></span>
                                <ul class="hover-variants-list">
                                    <% product.variants.forEach(v => { %>
                                    <li><span class="v-name"><%= v.name %></span> <span class="v-price"><%= v.price %> ر.س</span></li>
                                    <% }); %>
                                </ul>
                            </div>
                            <% } %>
                            <div class="hover-card-footer">
                                <span class="hover-price"><% if (product.sale_price != null && product.sale_price !== '' && (!product.variants || !product.variants.length)) { %><span class="price-old"><%= product.price %> ر.س</span> <span class="price-sale"><%= product.sale_price %> ر.س</span><% } else { %><%= (product.variants && product.variants.length) ? ('من ' + Math.min(...product.variants.map(v=>parseFloat(v.price)||0)) + ' ر.س') : (product.price + ' ر.س') %><% } %></span>
                                <button type="button" class="hover-add-btn" onclick="event.stopPropagation(); addToCart(<%= JSON.stringify(product) %>)"><i class="fas fa-cart-plus"></i> أضف للسلة</button>
                            </div>
                        </div>
                    </div>
                </div>
                <% }); %>
            </div>
        </div>
    </section>
    <% } %>

    <!-- قسم المنتجات حسب التصنيف -->
    <main class="container" id="products-section">
        <% if (locals.error) { %>
            <div class="error-message">
                <strong>تنبيه:</strong> <%= error %>
            </div>
        <% } %>

        <% if (!locals.products || products.length === 0) { %>
            <div class="no-products">
                <p>لا توجد منتجات متاحة حالياً.</p>
            </div>
        <% } else { %>
            <% 
                let catsToRender = categories;
                if (!catsToRender || catsToRender.length === 0) {
                    const uniqueCats = [...new Set(products.map(p => p.category))];
                    catsToRender = uniqueCats.map(c => ({ name: c, id: c }));
                }
                const catsWithProducts = catsToRender.filter(cat => products.some(p => p.category === cat.name));
            %>
            
            <!-- التصنيفات أعلى المنتجات -->
            <% const _otherProducts = products.filter(p => !catsToRender.map(c => c.name).includes(p.category)); %>
            <% if (catsWithProducts.length > 0 || _otherProducts.length > 0) { %>
            <section class="home-categories-bar">
                <h2 class="categories-bar-title"><i class="fas fa-th-large"></i> تصفح حسب التصنيف</h2>
                <div class="home-categories-scroll">
                <div class="home-categories-list">
                    <% catsWithProducts.forEach(function(cat) { %>
                        <% const cp = products.filter(p => p.category === cat.name); %>
                        <a href="#cat-<%= cat.id %>" class="home-category-card">
                            <span class="home-category-card-bg">
                                <img src="/images/category-card-bg.png" alt="" class="home-category-card-img">
                            </span>
                            <span class="home-category-card-text">
                                <span class="pill-name"><%= cat.name %></span>
                                <span class="pill-count">(<%= cp.length %>)</span>
                            </span>
                        </a>
                    <% }); %>
                    <% if (_otherProducts.length > 0) { %>
                    <a href="#cat-other" class="home-category-card">
                        <span class="home-category-card-bg">
                            <img src="/images/category-card-bg.png" alt="" class="home-category-card-img">
                        </span>
                        <span class="home-category-card-text">
                            <span class="pill-name">أخرى</span>
                            <span class="pill-count">(<%= _otherProducts.length %>)</span>
                        </span>
                    </a>
                    <% } %>
                </div>
                </div>
            </section>
            <% } %>
            
            <!-- البانر 1: بعد شريط التصنيفات مباشرة -->
            <% const _b1 = typeof banner1 !== 'undefined' && banner1; const _b2 = typeof banner2 !== 'undefined' && banner2; %>
            <% if (_b1) { %>
            <section class="home-banners home-banners-between-cats home-banner-single">
                <div class="container home-banners-inner">
                    <div class="home-banner-item">
                        <img src="<%= banner1 %>" alt="بانر 1" loading="lazy">
                    </div>
                </div>
            </section>
            <% } %>
            
            <% catsToRender.forEach(function(cat, catIndex) { %>
                <% const catProducts = products.filter(p => p.category === cat.name); %>
                <% if (catProducts.length > 0) { %>
                    <section class="category-block" id="cat-<%= cat.id %>">
                        <div class="category-header">
                            <h2 class="category-title"><%= cat.name %></h2>
                        </div>
                        
                        <div class="products-grid">
                            <% catProducts.forEach(function(product) { %>
                                <div class="product-card product-has-hover" data-id="<%= product.id %>">
                                    <div class="product-image">
                                        <img src="<%= (product.images && product.images[0]) || product.image_url || 'https://via.placeholder.com/600x400?text=No+Image' %>" alt="<%= product.name %>" loading="lazy">
                                        <span class="price"><% if (product.sale_price != null && product.sale_price !== '' && (!product.variants || !product.variants.length)) { %><span class="price-old"><%= product.price %> ر.س</span> <span class="price-sale"><%= product.sale_price %> ر.س</span><% } else { %><%= (product.variants && product.variants.length) ? ('من ' + Math.min(...product.variants.map(v=>parseFloat(v.price)||0)) + ' ر.س') : (product.price + ' ر.س') %><% } %></span>
                                    </div>
                                    <div class="product-info">
                                        <h3><%= product.name %></h3>
                                        <p><%= product.description %></p>
                                        <div class="product-actions">
                                            <button class="order-btn add-to-cart-btn" 
                                                onclick="addToCart(<%= JSON.stringify(product) %>)"
                                            >
                                                <i class="fas fa-cart-plus"></i> أضف للسلة
                                            </button>
                                            
                                            <div class="qty-control-widget" style="display: none;">
                                                <button class="qty-btn minus" onclick="updateItemQty(<%= product.id %>, -1)"><i class="fas fa-minus"></i></button>
                                                <span class="qty-display">1</span>
                                                <button class="qty-btn plus" onclick="updateItemQty(<%= product.id %>, 1)"><i class="fas fa-plus"></i></button>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- بطاقة التفاصيل عند تمرير الماوس -->
                                    <div class="product-hover-card">
                                        <div class="hover-card-content">
                                            <div class="hover-card-header">
                                                <img src="<%= (product.images && product.images[0]) || product.image_url || 'https://via.placeholder.com/600x400?text=No+Image' %>" alt="<%= product.name %>" class="hover-card-img">
                                                <div class="hover-card-title-block">
                                                    <h4><%= product.name %></h4>
                                                    <span class="hover-category"><i class="fas fa-tag"></i> <%= product.category %></span>
                                                </div>
                                            </div>
                                            <p class="hover-desc"><%= product.description || '—' %></p>
                                            <% if (product.details && product.details.trim()) { %>
                                            <div class="hover-details-block">
                                                <span class="hover-details-label"><i class="fas fa-info-circle"></i> التفاصيل</span>
                                                <p class="hover-details"><%= product.details %></p>
                                            </div>
                                            <% } %>
                                            <% if (product.variants && product.variants.length > 0) { %>
                                            <div class="hover-variants-block">
                                                <span class="hover-details-label"><i class="fas fa-<%= product.variant_type === 'weight' ? 'weight-hanging' : 'ruler-combined' %>"></i> <%= product.variant_type === 'weight' ? 'الأوزان' : 'الأحجام' %></span>
                                                <ul class="hover-variants-list">
                                                    <% product.variants.forEach(v => { %>
                                                    <li><span class="v-name"><%= v.name %></span> <span class="v-price"><%= v.price %> ر.س</span></li>
                                                    <% }); %>
                                                </ul>
                                            </div>
                                            <% } %>
                                            <div class="hover-card-footer">
                                                <span class="hover-price"><% if (product.sale_price != null && product.sale_price !== '' && (!product.variants || !product.variants.length)) { %><span class="price-old"><%= product.price %> ر.س</span> <span class="price-sale"><%= product.sale_price %> ر.س</span><% } else { %><%= (product.variants && product.variants.length) ? ('من ' + Math.min(...product.variants.map(v=>parseFloat(v.price)||0)) + ' ر.س') : (product.price + ' ر.س') %><% } %></span>
                                                <button type="button" class="hover-add-btn" onclick="event.stopPropagation(); addToCart(<%= JSON.stringify(product) %>)"><i class="fas fa-cart-plus"></i> أضف للسلة</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    </section>
                    <!-- البانر 2: بعد أول قسم تصنيف (بين التصنيفات) -->
                    <% if (catIndex === 0 && _b2) { %>
                    <section class="home-banners home-banners-between-cats home-banner-single">
                        <div class="container home-banners-inner">
                            <div class="home-banner-item">
                                <img src="<%= banner2 %>" alt="بانر 2" loading="lazy">
                            </div>
                        </div>
                    </section>
                    <% } %>
                <% } %>
            <% }); %>
            
            <!-- Handle Uncategorized Products (optional, if any product doesn't match known categories) -->
            <% const knownCatNames = catsToRender.map(c => c.name); %>
            <% const otherProducts = products.filter(p => !knownCatNames.includes(p.category)); %>
            <% if (otherProducts.length > 0) { %>
                <section class="category-block" id="cat-other">
                    <div class="category-header">
                        <h2 class="category-title">أخرى</h2>
                    </div>
                    <div class="products-grid">
                        <% otherProducts.forEach(function(product) { %>
                            <div class="product-card product-has-hover" data-id="<%= product.id %>">
                                <div class="product-image">
                                    <img src="<%= (product.images && product.images[0]) || product.image_url || 'https://via.placeholder.com/600x400?text=No+Image' %>" alt="<%= product.name %>" loading="lazy">
                                    <span class="price"><% if (product.sale_price != null && product.sale_price !== '' && (!product.variants || !product.variants.length)) { %><span class="price-old"><%= product.price %> ر.س</span> <span class="price-sale"><%= product.sale_price %> ر.س</span><% } else { %><%= (product.variants && product.variants.length) ? ('من ' + Math.min(...product.variants.map(v=>parseFloat(v.price)||0)) + ' ر.س') : (product.price + ' ر.س') %><% } %></span>
                                </div>
                                <div class="product-info">
                                    <h3><%= product.name %></h3>
                                    <p><%= product.description %></p>
                                    <div class="product-actions">
                                        <button class="order-btn add-to-cart-btn" onclick="addToCart(<%= JSON.stringify(product) %>)">
                                            <i class="fas fa-cart-plus"></i> أضف للسلة
                                        </button>
                                        <div class="qty-control-widget" style="display: none;">
                                            <button class="qty-btn minus" onclick="updateItemQty(<%= product.id %>, -1)"><i class="fas fa-minus"></i></button>
                                            <span class="qty-display">1</span>
                                            <button class="qty-btn plus" onclick="updateItemQty(<%= product.id %>, 1)"><i class="fas fa-plus"></i></button>
                                        </div>
                                    </div>
                                </div>
                                <div class="product-hover-card">
                                    <div class="hover-card-content">
                                        <div class="hover-card-header">
                                            <img src="<%= (product.images && product.images[0]) || product.image_url || 'https://via.placeholder.com/600x400?text=No+Image' %>" alt="<%= product.name %>" class="hover-card-img">
                                            <div class="hover-card-title-block">
                                                <h4><%= product.name %></h4>
                                                <span class="hover-category"><i class="fas fa-tag"></i> <%= product.category %></span>
                                            </div>
                                        </div>
                                        <p class="hover-desc"><%= product.description || '—' %></p>
                                        <% if (product.details && product.details.trim()) { %>
                                        <div class="hover-details-block">
                                            <span class="hover-details-label"><i class="fas fa-info-circle"></i> التفاصيل</span>
                                            <p class="hover-details"><%= product.details %></p>
                                        </div>
                                        <% } %>
                                        <% if (product.variants && product.variants.length > 0) { %>
                                        <div class="hover-variants-block">
                                            <span class="hover-details-label"><i class="fas fa-<%= product.variant_type === 'weight' ? 'weight-hanging' : 'ruler-combined' %>"></i> <%= product.variant_type === 'weight' ? 'الأوزان' : 'الأحجام' %></span>
                                            <ul class="hover-variants-list">
                                                <% product.variants.forEach(v => { %>
                                                <li><span class="v-name"><%= v.name %></span> <span class="v-price"><%= v.price %> ر.س</span></li>
                                                <% }); %>
                                            </ul>
                                        </div>
                                        <% } %>
                                        <div class="hover-card-footer">
                                            <span class="hover-price"><% if (product.sale_price != null && product.sale_price !== '' && (!product.variants || !product.variants.length)) { %><span class="price-old"><%= product.price %> ر.س</span> <span class="price-sale"><%= product.sale_price %> ر.س</span><% } else { %><%= (product.variants && product.variants.length) ? ('من ' + Math.min(...product.variants.map(v=>parseFloat(v.price)||0)) + ' ر.س') : (product.price + ' ر.س') %><% } %></span>
                                            <button type="button" class="hover-add-btn" onclick="event.stopPropagation(); addToCart(<%= JSON.stringify(product) %>)"><i class="fas fa-cart-plus"></i> أضف للسلة</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </section>
            <% } %>

        <% } %>
    </main>

