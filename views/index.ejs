        var block = document.getElementById('restCategoriesBlock');
        if (!btn || !block) return;
        var count = btn.getAttribute('data-count') || '0';
        btn.addEventListener('click', function() {
            var isHidden = block.hidden;
            block.hidden = !isHidden;
            btn.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
            var pill = btn.querySelector('.pill-name');
            if (pill) pill.innerHTML = isHidden ? '<i class=\"fas fa-chevron-up\"></i> <%= t.home.hideCategories %>' : '<i class=\"fas fa-chevron-down\"></i> <%= t.home.otherCategories %> (' + count + ')';
