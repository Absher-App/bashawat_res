<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'ar' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'rtl' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>حلويات بقداش - Bagdash sweets</title>
    <meta name="description" content="حلويات بقداش - أفضل حلويات عربية وكيك. طلب أونلاين وتوصيل. كنافة، بقلاوة، بسبوسة، كيك مناسبات.">
    <meta name="keywords" content="حلويات بقداش، بقداش، حلويات عربية، كنافة، بقلاوة، توصيل حلويات">
    <meta name="author" content="حلويات بقداش">
    <% if (typeof siteUrl !== 'undefined' && siteUrl) { %>
    <link rel="canonical" href="<%= siteUrl %>/">
    <meta property="og:url" content="<%= siteUrl %>/">
    <% } %>
    <meta property="og:type" content="website">
    <meta property="og:title" content="حلويات بقداش - Bagdash sweets">
    <meta property="og:description" content="أفضل حلويات عربية وكيك. طلب أونلاين وتوصيل.">
    <meta property="og:locale" content="ar_SA">
    <meta property="og:image" content="<%= typeof siteUrl !== 'undefined' && siteUrl ? siteUrl : '' %>/images/logo.png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="حلويات بقداش - Bagdash sweets">
    <meta name="twitter:description" content="أفضل حلويات عربية وكيك. طلب أونلاين وتوصيل.">
    <meta name="twitter:image" content="<%= typeof siteUrl !== 'undefined' && siteUrl ? siteUrl : '' %>/images/logo.png">
    <link rel="icon" href="/images/logo.png" type="image/png">
    <link rel="stylesheet" href="/css/style.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700&display=swap" rel="stylesheet">
    <!-- إضافة أيقونات Font Awesome للسلة -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <!-- Header: شريط العروض + التوبار -->
    <header class="site-header">
        <div class="offers-banner">
            <div class="offers-marquee-wrap" aria-hidden="true">
                <span class="offers-text"><%= offer_text || (typeof t !== 'undefined' && t.offer ? '✨ ' + t.offer : '') %></span>
                <span class="offers-text"><%= offer_text || (typeof t !== 'undefined' && t.offer ? '✨ ' + t.offer : '') %></span>
            </div>
        </div>
        <nav class="topbar">
            <div class="container topbar-content">
                <a href="/" class="logo-area">
                    <img src="/images/logo.png" alt="<%= t.common.brandName %>" class="nav-logo">
                    <span class="brand-name"><%= t.common.brandName %> <em class="brand-en"><%= t.common.brandEn %></em></span>
                </a>
                <ul class="nav-links">
                    <li><a href="/" class="nav-link active"><%= t.nav.home %></a></li>
                    <li><a href="/products" class="nav-link"><%= t.nav.products %></a></li>
                    <li><a href="/parties" class="nav-link"><%= t.nav.parties %></a></li>
                    <li><a href="/cart" class="nav-link nav-cart"><%= t.nav.cart %> <i class="fas fa-shopping-cart"></i></a></li>
                </ul>
                <div class="topbar-social">
                    <a href="https://www.instagram.com/bodatbagdash/" target="_blank" rel="noopener" aria-label="انستغرام"><i class="fab fa-instagram"></i></a>
                    <a href="https://x.com/BodatBagdash" target="_blank" rel="noopener" aria-label="تويتر"><i class="fab fa-twitter"></i></a>
                    <a href="https://www.snapchat.com/@bagdashsweet" target="_blank" rel="noopener" aria-label="سناب شات"><i class="fab fa-snapchat-ghost"></i></a>
                    <a href="https://www.tiktok.com/@bagdashsweet" target="_blank" rel="noopener" aria-label="تيك توك"><i class="fab fa-tiktok"></i></a>
                    <a href="https://www.facebook.com/bagdashsweet/" target="_blank" rel="noopener" aria-label="فيسبوك"><i class="fab fa-facebook-f"></i></a>
                </div>
                <%- include('partials/lang-switcher') %>
                <button type="button" class="burger-btn" id="burgerBtn" aria-label="<%= t.nav.menu %>">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </nav>
    </header>

    <!-- درج القائمة (موبايل) -->
    <div class="drawer-overlay" id="drawerOverlay" aria-hidden="true"></div>
    <div class="drawer" id="drawer">
        <div class="drawer-header">
            <span class="drawer-title"><%= t.nav.menu %></span>
            <button type="button" class="drawer-close" id="drawerClose" aria-label="<%= t.nav.close %>"><i class="fas fa-times"></i></button>
        </div>
        <nav class="drawer-nav">
            <a href="/" class="drawer-link active"><%= t.nav.home %></a>
            <a href="/products" class="drawer-link"><%= t.nav.products %></a>
            <a href="/parties" class="drawer-link"><%= t.nav.parties %></a>
            <a href="/cart" class="drawer-link"><%= t.nav.cart %> <i class="fas fa-shopping-cart"></i></a>
        </nav>
        <div class="drawer-lang"><%- include('partials/lang-switcher') %></div>
        <div class="drawer-social">
            <span class="drawer-social-label"><%= t.nav.followUs %></span>
            <a href="https://www.instagram.com/bodatbagdash/" target="_blank" rel="noopener" aria-label="انستغرام"><i class="fab fa-instagram"></i></a>
            <a href="https://x.com/BodatBagdash" target="_blank" rel="noopener" aria-label="تويتر"><i class="fab fa-twitter"></i></a>
            <a href="https://www.snapchat.com/@bagdashsweet" target="_blank" rel="noopener" aria-label="سناب شات"><i class="fab fa-snapchat-ghost"></i></a>
            <a href="https://www.tiktok.com/@bagdashsweet" target="_blank" rel="noopener" aria-label="تيك توك"><i class="fab fa-tiktok"></i></a>
            <a href="https://www.facebook.com/bagdashsweet/" target="_blank" rel="noopener" aria-label="فيسبوك"><i class="fab fa-facebook-f"></i></a>
        </div>
    </div>

    <!-- زر السلة العائم -->
    <a href="/cart" class="cart-floating-btn" id="cartBtn">
        <i class="fas fa-shopping-cart"></i>
        <span class="cart-count" id="cartCount">0</span>
    </a>

    <!-- قسم السلايدر — صورة واحدة بالمنتصف، التحريك يمين للصورة التالية -->
    <section class="hero-slider" id="heroSlider">
        <div class="slider-container">
            <div class="slider-track" id="sliderTrack">
                <% if (slides && slides.length > 0) { %>
                    <% slides.forEach((slide, index) => { %>
                    <div class="slide <%= index === 0 ? 'active' : '' %>" style="background-image: url('<%= slide.image_url %>');">
                        <div class="slide-content">
                            <% if(slide.title) { %><h2><%= slide.title %></h2><% } %>
                            <% if(slide.subtitle) { %><p><%= slide.subtitle %></p><% } %>
                            <% if(slide.link_url) { %>
                                <a href="<%= slide.link_url %>" class="cta-btn"><%= (slide.button_text && slide.button_text.trim()) ? slide.button_text : t.slider.viewMore %></a>
                            <% } %>
                        </div>
                    </div>
                    <% }); %>
                <% } else { %>
                    <div class="slide active" style="background-image: url('https://images.unsplash.com/photo-1579372786545-d24232daf58c?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80');">
                        <div class="slide-content">
                            <h2><%= t.slider.heroTitle %></h2>
                            <p><%= t.slider.heroSub %></p>
                            <a href="#products-section" class="cta-btn"><%= t.slider.viewMenu %></a>
                        </div>
                    </div>
                <% } %>
            </div>
            <button type="button" class="slider-arrow slider-prev" aria-label="<%= t.slider.prev %>">&#10094;</button>
            <button type="button" class="slider-arrow slider-next" aria-label="<%= t.slider.next %>">&#10095;</button>
            <div class="slider-dots" id="sliderDots"></div>
        </div>
    </section>

    <!-- قسم الستوريات / الفيديوهات -->
    <% if (stories && stories.length > 0) { %>
    <section class="stories-section">
        <div class="container">
            <div class="stories-scroll-wrapper">
                <div class="stories-scroll-container">
                    <% stories.forEach(function(story) { %>
                    <div class="story-item" onclick="openStoryModal('<%= story.video_url %>', '<%= story.title %>')">
                        <div class="story-circle">
                            <img src="<%= story.cover_url %>" alt="<%= story.title %>">
                        </div>
                        <span class="story-title"><%= story.title || 'ستوري' %></span>
                    </div>
                    <% }); %>
                </div>
            </div>
        </div>
    </section>
    <!-- مودال عرض الفيديو -->
    <div class="story-video-modal" id="storyVideoModal" onclick="closeStoryModal(event)">
        <button class="story-modal-close" onclick="closeStoryModal(event)">&times;</button>
        <div class="story-modal-content" onclick="event.stopPropagation()">
            <h3 class="story-modal-title" id="storyModalTitle"></h3>
            <video id="storyVideoPlayer" controls playsinline></video>
        </div>
    </div>
    <% } %>

    <!-- تصفح حسب التصنيف (فوق الأكثر مبيعاً) -->
    <% if (locals.products && products.length > 0) { %>
            <% 
                var catsToRender = categories;
                if (!catsToRender || catsToRender.length === 0) {
                    var uniqueCats = [...new Set(products.map(p => p.category))];
                    catsToRender = uniqueCats.map(c => ({ name: c, id: c }));
                }
                var catsWithProducts = catsToRender.filter(cat => products.some(p => p.category === cat.name));
                var MAX_HOME_CATEGORIES = 5;
                var mainCatsToShow = catsWithProducts.slice(0, MAX_HOME_CATEGORIES);
                var restCats = catsWithProducts.slice(MAX_HOME_CATEGORIES);
                var knownCatNamesAll = catsWithProducts.map(c => c.name);
                var otherProducts = products.filter(p => !knownCatNamesAll.includes(p.category));
            %>
            <% if (mainCatsToShow.length > 0 || otherProducts.length > 0 || (restCats && restCats.length > 0)) { %>
            <section class="home-categories-bar">
                <h2 class="categories-bar-title"><i class="fas fa-th-large"></i> <%= t.home.browseByCategory %></h2>
                <div class="home-categories-scroll">
                <div class="home-categories-list">
                    <% mainCatsToShow.forEach(function(cat) { %>
                        <% const cp = products.filter(p => p.category === cat.name); %>
                        <a href="#cat-<%= cat.id %>" class="home-category-card">
                            <span class="home-category-card-bg">
                                <img src="/images/category-card-bg.png" alt="" class="home-category-card-img">
                            </span>
                            <span class="home-category-card-text">
                                <span class="pill-name"><%= cat.name %></span>
                                <span class="pill-count">(<%= cp.length %>)</span>
                            </span>
                        </a>
                    <% }); %>
                    <% if (typeof iceCreamOptions !== 'undefined' && iceCreamOptions && (iceCreamOptions.cupSizes || []).length > 0) { %>
                    <a href="#ice-cream-section" class="home-category-card">
                        <span class="home-category-card-bg">
                            <img src="/images/category-card-bg.png" alt="" class="home-category-card-img">
                        </span>
                        <span class="home-category-card-text">
                            <span class="pill-name"><%= t.home.iceCream %></span>
                        </span>
                    </a>
                    <% } %>
                    <% if (otherProducts.length > 0) { %>
                    <a href="#cat-other" class="home-category-card">
                        <span class="home-category-card-bg">
                            <img src="/images/category-card-bg.png" alt="" class="home-category-card-img">
                        </span>
                        <span class="home-category-card-text">
                            <span class="pill-name"><%= t.home.other %></span>
                            <span class="pill-count">(<%= otherProducts.length %>)</span>
                        </span>
                    </a>
                    <% } %>
                    <% if (restCats && restCats.length > 0) { %>
                    <button type="button" class="home-category-card home-category-card-more" id="btnShowRestCategories" aria-expanded="false" data-count="<%= restCats.length %>">
                        <span class="home-category-card-bg">
                            <img src="/images/category-card-bg.png" alt="" class="home-category-card-img">
                        </span>
                        <span class="home-category-card-text">
                            <span class="pill-name"><i class="fas fa-chevron-down"></i> <%= t.home.otherCategories %> (<%= restCats.length %>)</span>
                        </span>
                    </button>
                    <% } %>
                </div>
                </div>
            </section>
            <% } %>
    <% } %>

    <!-- قسم الأكثر مبيعاً — عنوان واحد احترافي -->
    <% const _mostRequested = (typeof mostRequestedProducts !== 'undefined' && mostRequestedProducts) ? mostRequestedProducts : []; %>
    <% if (_mostRequested.length > 0) { %>
    <section class="most-requested-section">
        <div class="container">
            <header class="section-head-pro">
                <span class="section-head-accent" aria-hidden="true"></span>
                <h2 class="section-head-title"><i class="fas fa-chart-line section-head-icon"></i> <%= t.home.mostSold %></h2>
                <div class="section-head-decoration" aria-hidden="true"><span class="line"></span><span class="dot"></span><span class="line"></span></div>
            </header>
            <div class="products-grid most-requested-grid">
                <% _mostRequested.forEach(function(product) { %>
                <div class="product-card product-has-hover" data-id="<%= product.id %>">
                    <a href="/product/<%= product.id %>" class="product-card-link">
                        <div class="product-image">
                            <img src="<%= (product.images && product.images[0]) || product.image_url || 'https://via.placeholder.com/600x400?text=No+Image' %>" alt="<%= product.name %>" loading="lazy">
                            <span class="price"><% if (product.sale_price != null && product.sale_price !== '' && (!product.variants || !product.variants.length)) { %><span class="price-old"><%= product.price %> <%= t.common.sar %></span> <span class="price-sale"><%= product.sale_price %> <%= t.common.sar %></span><% } else { %><%= (product.variants && product.variants.length) ? (t.common.priceFrom + ' ' + Math.min(...product.variants.map(v=>parseFloat(v.price)||0)) + ' ' + t.common.sar) : (product.price + ' ' + t.common.sar) %><% } %></span>
                        </div>
                        <div class="product-info">
                            <h3><%= product.name %></h3>
                            <p><%= product.description %></p>
                        </div>
                    </a>
                    <div class="product-actions">
                        <button class="order-btn add-to-cart-btn" onclick="event.preventDefault(); event.stopPropagation(); addToCart(<%= JSON.stringify(product) %>)">
                            <i class="fas fa-cart-plus"></i> <%= t.home.addToCart %>
                        </button>
                        <div class="qty-control-widget" style="display: none;">
                            <button class="qty-btn minus" onclick="updateItemQty(<%= product.id %>, -1)"><i class="fas fa-minus"></i></button>
                            <span class="qty-display">1</span>
                            <button class="qty-btn plus" onclick="updateItemQty(<%= product.id %>, 1)"><i class="fas fa-plus"></i></button>
                        </div>
                    </div>
                </div>
                <% }); %>
            </div>
        </div>
    </section>
    <% } %>

    <!-- قسم المنتجات حسب التصنيف -->
    <main class="container" id="products-section">
        <% if (locals.error) { %>
            <div class="error-message">
                <strong><%= t.error %>:</strong> <%= error %>
            </div>
        <% } %>

        <% if (!locals.products || products.length === 0) { %>
            <div class="no-products">
                <p><%= t.noProducts %></p>
            </div>
        <% } %>
        <% if (locals.products && products.length > 0) { %>
            <!-- البانر 1: فيديو قصير (بعد شريط التصنيفات) -->
            <% const _b1 = typeof banner1 !== 'undefined' && banner1; const _b2 = typeof banner2 !== 'undefined' && banner2; %>
            <% const _b1IsVideo = _b1 && /\.(mp4|webm|ogg|mov)(\?|$)/i.test(banner1); %>
            <% if (_b1) { %>
            <section class="home-banners home-banners-between-cats home-banner-single">
                <div class="container home-banners-inner">
                    <div class="home-banner-item home-banner-item-video">
                        <% if (_b1IsVideo) { %>
                        <video src="<%= banner1 %>" autoplay muted loop playsinline class="home-banner-media" aria-label="بانر فيديو"></video>
                        <% } else { %>
                        <img src="<%= banner1 %>" alt="بانر 1" loading="lazy" class="home-banner-media">
                        <% } %>
                    </div>
                </div>
            </section>
            <% } %>
            
            <% mainCatsToShow.forEach(function(cat, catIndex) { %>
                <% const catProducts = products.filter(p => p.category === cat.name); %>
                <% if (catProducts.length > 0) { %>
                    <section class="category-block" id="cat-<%= cat.id %>">
                        <div class="category-header category-header-pro">
                            <div class="category-header-inner">
                                <span class="category-header-accent" aria-hidden="true"></span>
                                <h2 class="category-title"><i class="fas fa-tag category-title-icon"></i><%= cat.name %></h2>
                                <span class="category-header-count"><%= catProducts.length %> <%= t.home.productCount %></span>
                            </div>
                            <div class="category-header-line" aria-hidden="true"><span class="line"></span><span class="dot"></span><span class="line"></span></div>
                        </div>
                        <div class="products-grid">
                            <% catProducts.forEach(function(product) { %>
                                <div class="product-card product-has-hover" data-id="<%= product.id %>">
                                    <a href="/product/<%= product.id %>" class="product-card-link">
                                        <div class="product-image">
                                            <img src="<%= (product.images && product.images[0]) || product.image_url || 'https://via.placeholder.com/600x400?text=No+Image' %>" alt="<%= product.name %>" loading="lazy">
                                            <span class="price"><% if (product.sale_price != null && product.sale_price !== '' && (!product.variants || !product.variants.length)) { %><span class="price-old"><%= product.price %> <%= t.common.sar %></span> <span class="price-sale"><%= product.sale_price %> <%= t.common.sar %></span><% } else { %><%= (product.variants && product.variants.length) ? (t.common.priceFrom + ' ' + Math.min(...product.variants.map(v=>parseFloat(v.price)||0)) + ' ' + t.common.sar) : (product.price + ' ' + t.common.sar) %><% } %></span>
                                        </div>
                                        <div class="product-info">
                                            <h3><%= product.name %></h3>
                                            <p><%= product.description %></p>
                                        </div>
                                    </a>
                                    <div class="product-actions">
                                        <button class="order-btn add-to-cart-btn" onclick="event.preventDefault(); event.stopPropagation(); addToCart(<%= JSON.stringify(product) %>)">
                                            <i class="fas fa-cart-plus"></i> <%= t.home.addToCart %>
                                        </button>
                                        <div class="qty-control-widget" style="display: none;">
                                            <button class="qty-btn minus" onclick="updateItemQty(<%= product.id %>, -1)"><i class="fas fa-minus"></i></button>
                                            <span class="qty-display">1</span>
                                            <button class="qty-btn plus" onclick="updateItemQty(<%= product.id %>, 1)"><i class="fas fa-plus"></i></button>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    </section>
                    <!-- البانر 2: بعد أول قسم تصنيف (بين التصنيفات) -->
                    <% if (catIndex === 0 && _b2) { %>
                    <section class="home-banners home-banners-between-cats home-banner-single">
                        <div class="container home-banners-inner">
                            <div class="home-banner-item">
                                <img src="<%= banner2 %>" alt="بانر 2" loading="lazy">
                            </div>
                        </div>
                    </section>
                    <% } %>
                <% } %>
            <% }); %>
            
            <!-- بقية التصنيفات (تظهر عند الضغط على "بقية التصنيفات") -->
            <% if (restCats && restCats.length > 0) { %>
            <div class="rest-categories-wrap" id="restCategoriesBlock" hidden>
                <% restCats.forEach(function(cat, catIndex) { %>
                    <% const catProducts = products.filter(p => p.category === cat.name); %>
                    <% if (catProducts.length > 0) { %>
                    <section class="category-block" id="cat-<%= cat.id %>">
                        <div class="category-header category-header-pro">
                            <div class="category-header-inner">
                                <span class="category-header-accent" aria-hidden="true"></span>
                                <h2 class="category-title"><i class="fas fa-tag category-title-icon"></i><%= cat.name %></h2>
                                <span class="category-header-count"><%= catProducts.length %> <%= t.home.productCount %></span>
                            </div>
                            <div class="category-header-line" aria-hidden="true"><span class="line"></span><span class="dot"></span><span class="line"></span></div>
                        </div>
                        <div class="products-grid">
                            <% catProducts.forEach(function(product) { %>
                                <div class="product-card product-has-hover" data-id="<%= product.id %>">
                                    <a href="/product/<%= product.id %>" class="product-card-link">
                                        <div class="product-image">
                                            <img src="<%= (product.images && product.images[0]) || product.image_url || 'https://via.placeholder.com/600x400?text=No+Image' %>" alt="<%= product.name %>" loading="lazy">
                                            <span class="price"><% if (product.sale_price != null && product.sale_price !== '' && (!product.variants || !product.variants.length)) { %><span class="price-old"><%= product.price %> <%= t.common.sar %></span> <span class="price-sale"><%= product.sale_price %> <%= t.common.sar %></span><% } else { %><%= (product.variants && product.variants.length) ? (t.common.priceFrom + ' ' + Math.min(...product.variants.map(v=>parseFloat(v.price)||0)) + ' ' + t.common.sar) : (product.price + ' ' + t.common.sar) %><% } %></span>
                                        </div>
                                        <div class="product-info">
                                            <h3><%= product.name %></h3>
                                            <p><%= product.description %></p>
                                        </div>
                                    </a>
                                    <div class="product-actions">
                                        <button class="order-btn add-to-cart-btn" onclick="event.preventDefault(); event.stopPropagation(); addToCart(<%= JSON.stringify(product) %>)">
                                            <i class="fas fa-cart-plus"></i> <%= t.home.addToCart %>
                                        </button>
                                        <div class="qty-control-widget" style="display: none;">
                                            <button class="qty-btn minus" onclick="updateItemQty(<%= product.id %>, -1)"><i class="fas fa-minus"></i></button>
                                            <span class="qty-display">1</span>
                                            <button class="qty-btn plus" onclick="updateItemQty(<%= product.id %>, 1)"><i class="fas fa-plus"></i></button>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    </section>
                    <% } %>
                <% }); %>
            </div>
            <% } %>
            
            <!-- أخرى: منتجات لا تنتمي لأي تصنيف معروف -->
            <% if (otherProducts.length > 0) { %>
                <section class="category-block" id="cat-other">
                    <div class="category-header category-header-pro">
                        <div class="category-header-inner">
                            <span class="category-header-accent" aria-hidden="true"></span>
                            <h2 class="category-title"><i class="fas fa-tag category-title-icon"></i><%= t.home.other %></h2>
                            <span class="category-header-count"><%= otherProducts.length %> <%= t.home.productCount %></span>
                        </div>
                        <div class="category-header-line" aria-hidden="true"><span class="line"></span><span class="dot"></span><span class="line"></span></div>
                    </div>
                    <div class="products-grid">
                        <% otherProducts.forEach(function(product) { %>
                            <div class="product-card product-has-hover" data-id="<%= product.id %>">
                                <a href="/product/<%= product.id %>" class="product-card-link">
                                    <div class="product-image">
                                        <img src="<%= (product.images && product.images[0]) || product.image_url || 'https://via.placeholder.com/600x400?text=No+Image' %>" alt="<%= product.name %>" loading="lazy">
                                        <span class="price"><% if (product.sale_price != null && product.sale_price !== '' && (!product.variants || !product.variants.length)) { %><span class="price-old"><%= product.price %> <%= t.common.sar %></span> <span class="price-sale"><%= product.sale_price %> <%= t.common.sar %></span><% } else { %><%= (product.variants && product.variants.length) ? (t.common.priceFrom + ' ' + Math.min(...product.variants.map(v=>parseFloat(v.price)||0)) + ' ' + t.common.sar) : (product.price + ' ' + t.common.sar) %><% } %></span>
                                    </div>
                                    <div class="product-info">
                                        <h3><%= product.name %></h3>
                                        <p><%= product.description %></p>
                                    </div>
                                </a>
                                <div class="product-actions">
                                    <button class="order-btn add-to-cart-btn" onclick="event.preventDefault(); event.stopPropagation(); addToCart(<%= JSON.stringify(product) %>)">
                                        <i class="fas fa-cart-plus"></i> <%= t.home.addToCart %>
                                    </button>
                                    <div class="qty-control-widget" style="display: none;">
                                        <button class="qty-btn minus" onclick="updateItemQty(<%= product.id %>, -1)"><i class="fas fa-minus"></i></button>
                                        <span class="qty-display">1</span>
                                        <button class="qty-btn plus" onclick="updateItemQty(<%= product.id %>, 1)"><i class="fas fa-plus"></i></button>
