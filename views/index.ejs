        <!-- قسم الآيسكريم — يظهر دائماً عند توفر الخيارات (يعمل في الرئيسية والمنتجات) -->
        <% if (typeof iceCreamOptions !== 'undefined' && iceCreamOptions && (iceCreamOptions.cupSizes || []).length > 0 && (iceCreamOptions.flavors || []).length > 0) { %>
            <section class="category-block" id="ice-cream-section">
                <div class="category-header category-header-pro">
                    <div class="category-header-inner">
                        <span class="category-header-accent" aria-hidden="true"></span>
                        <h2 class="category-title"><i class="fas fa-ice-cream category-title-icon"></i><%= t.home.iceCream %></h2>
                    </div>
                    <div class="category-header-line" aria-hidden="true"><span class="line"></span><span class="dot"></span><span class="line"></span></div>
                </div>
                <div class="ice-cream-builder">
                    <p class="ice-cream-step-label"><%= t.iceCream.step1 %></p>
                    <div class="ice-cream-cup-sizes" id="iceCreamCupSizes">
                        <% (iceCreamOptions.cupSizes || []).forEach(function(cup) { %>
                        <button type="button" class="ice-cream-cup-btn" data-name="<%= cup.name_ar %>" data-price="<%= cup.price %>" data-max-scoops="<%= cup.max_scoops %>" data-image-url="<%= (iceCreamOptions.cupImages && iceCreamOptions.cupImages[cup.name_ar]) ? iceCreamOptions.cupImages[cup.name_ar] : '' %>"><%= cup.name_ar %> — <%= cup.price %> <%= t.common.sar %> (<%= cup.max_scoops %> <%= t.iceCream.balls %>)</button>
                        <% }); %>
                    </div>
                    <div class="ice-cream-flavors-wrap" id="iceCreamFlavorsWrap" style="display: none;">
                        <p class="ice-cream-step-label"><%= t.iceCream.step2 %></p>
                        <div class="ice-cream-layout">
                            <div class="ice-cream-cup-visual" id="iceCreamCupVisual">
                                <div class="ice-cream-scoops-stack" id="iceCreamScoopsStack"></div>
                                <div class="ice-cream-cup-body" id="iceCreamCupBody"></div>
                            </div>
                            <div class="ice-cream-flavors-grid" id="iceCreamFlavorsGrid">
                                <% (iceCreamOptions.flavors || []).forEach(function(f, fi) { %>
                                <button type="button" class="ice-cream-flavor-btn" data-name="<%= f.name_ar %>" data-index="<%= fi %>"><%= f.name_ar %></button>
                                <% }); %>
                            </div>
                        </div>
                        <div class="ice-cream-current-cup" id="iceCreamCurrentCup">
                            <span class="ice-cream-cup-summary" id="iceCreamCupSummary"></span>
                            <span class="ice-cream-cup-price" id="iceCreamCupPrice"></span>
                        </div>
                        <button type="button" class="order-btn ice-cream-add-cart-btn" id="iceCreamAddToCartBtn" disabled>
                            <i class="fas fa-cart-plus"></i> <%= t.home.addToCart %>
                        </button>
                    </div>
                </div>
            </section>
            <script>
            document.addEventListener('DOMContentLoaded', function() {
                var scoopColors = ['#fff5e6','#ffb3d9','#8b4513','#4a0080','#0066cc','#ffeb99','#ff6b6b','#ff8c42','#d4a574','#98d8aa','#f5deb3','#1a1a1a'];
                var selectedCup = null;
                var selectedFlavors = [];
                var wrap = document.getElementById('iceCreamFlavorsWrap');
                var cupVisual = document.getElementById('iceCreamCupVisual');
                var scoopsStack = document.getElementById('iceCreamScoopsStack');
                var summary = document.getElementById('iceCreamCupSummary');
                var priceEl = document.getElementById('iceCreamCupPrice');
                var addBtn = document.getElementById('iceCreamAddToCartBtn');
                if (!wrap || !addBtn) return;
                var cupSizesEl = document.getElementById('iceCreamCupSizes');
                var flavorsGridEl = document.getElementById('iceCreamFlavorsGrid');
                if (!cupSizesEl || !flavorsGridEl) return;
                cupSizesEl.addEventListener('click', function(e) {
                    var btn = e.target.closest('.ice-cream-cup-btn');
                    if (!btn) return;
                    document.querySelectorAll('.ice-cream-cup-btn').forEach(function(b) { b.classList.remove('active'); });
                    btn.classList.add('active');
                    selectedCup = { name_ar: btn.dataset.name, price: parseFloat(btn.dataset.price), max_scoops: parseInt(btn.dataset.maxScoops, 10), imageUrl: btn.dataset.imageUrl || '' };
                    selectedFlavors = [];
                    wrap.style.display = 'block';
                    if (cupVisual) cupVisual.classList.add('visible');
                    if (scoopsStack) scoopsStack.innerHTML = '';
                    summary.textContent = '<%= t.iceCream.cupLabel %> ' + selectedCup.name_ar + ': —';
                    priceEl.textContent = selectedCup.price + ' <%= t.common.sar %>';
                    addBtn.disabled = true;
                });
                flavorsGridEl.addEventListener('click', function(e) {
                    var btn = e.target.closest('.ice-cream-flavor-btn');
                    if (!btn || !selectedCup) return;
                    if (selectedFlavors.length >= selectedCup.max_scoops) return;
                    var name = btn.getAttribute('data-name') || btn.dataset.name;
                    var idx = parseInt(btn.getAttribute('data-index'), 10) || selectedFlavors.length;
                    selectedFlavors.push(name);
                    var color = scoopColors[idx % scoopColors.length];
                    var ball = document.createElement('div');
                    ball.className = 'ice-cream-scoop-ball scoop-add';
                    ball.style.backgroundColor = color;
                    ball.setAttribute('title', name);
                    if (scoopsStack) {
                        scoopsStack.appendChild(ball);
                        ball.offsetHeight;
                        ball.classList.add('scoop-visible');
                    }
                    summary.textContent = '<%= t.iceCream.cupLabel %> ' + selectedCup.name_ar + ': ' + selectedFlavors.join(', ');
                    priceEl.textContent = selectedCup.price + ' <%= t.common.sar %>';
                    addBtn.disabled = false;
                });
                addBtn.addEventListener('click', function() {
                    if (!selectedCup || selectedFlavors.length === 0 || typeof window.addIceCreamToCart !== 'function') return;
                    window.addIceCreamToCart(selectedCup, selectedFlavors);
                    addBtn.innerHTML = '<i class="fas fa-check"></i> تمت الإضافة';
                    addBtn.disabled = true;
                    setTimeout(function() {
                        addBtn.innerHTML = '<i class="fas fa-cart-plus"></i> <%= t.home.addToCart %>';
                        addBtn.disabled = selectedFlavors.length === 0;
                    }, 2000);
                });
            });
            </script>
        <% } %>
    </main>

