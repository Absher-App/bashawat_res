    <% if (stories && stories.length > 0) { %>
    <script>
        function openStoryModal(videoUrl, title) {
            const modal = document.getElementById('storyVideoModal');
            const player = document.getElementById('storyVideoPlayer');
            const titleEl = document.getElementById('storyModalTitle');
            if (modal && player) {
                titleEl.textContent = title || '';
                player.src = videoUrl;
                modal.classList.add('active');
                document.body.style.overflow = 'hidden';
            }
        }
        function closeStoryModal(e) {
            if (!e) return;
            const modal = document.getElementById('storyVideoModal');
            const player = document.getElementById('storyVideoPlayer');
            if (modal && player && (e.target.classList.contains('story-modal-close') || e.target.id === 'storyVideoModal')) {
                modal.classList.remove('active');
                player.pause();
                player.src = '';
                document.body.style.overflow = '';
            }
        }
    </script>
    <% } %>
