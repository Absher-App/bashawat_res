<!-- مودال اختيار الحجم/الوزن -->
<div id="variantModal" class="cake-modal variant-modal">
    <div class="cake-modal-content">
        <span class="cake-modal-close" onclick="closeVariantModal()">&times;</span>
        <h3><i class="fas fa-weight-hanging"></i> اختر <span id="variantModalLabel">الحجم</span></h3>
        <p class="cake-modal-product-name" id="variantModalProductName"></p>
        <div id="variantOptionsList" class="variant-options-list"></div>
        <button type="button" id="variantModalAddBtn" class="cake-submit-btn" style="margin-top:16px;">
            <i class="fas fa-cart-plus"></i> أضف للسلة
        </button>
    </div>
</div>
