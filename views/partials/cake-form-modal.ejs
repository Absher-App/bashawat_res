<!-- مودال بيانات طلب الكيك -->
<div id="cakeFormModal" class="cake-modal">
    <div class="cake-modal-content">
        <span class="cake-modal-close" onclick="closeCakeModal()">&times;</span>
        <h3><i class="fas fa-birthday-cake"></i> تفاصيل طلب الكيك</h3>
        <p class="cake-modal-product-name" id="cakeModalProductName"></p>
        
        <form id="cakeOrderForm">
            <input type="hidden" id="cakeProductData" name="productData">
            
            <div class="form-group">
                <label>الأحجام <span class="required">*</span></label>
                <small class="field-hint">يضاف سعر تصميم الكيك إلى سعر حجم الكيك</small>
                <select name="size" id="cakeSize" required>
                    <option value="">اختر</option>
                    <option value="صغير">صغير</option>
                    <option value="وسط">وسط</option>
                    <option value="كبير">كبير</option>
                </select>
            </div>
            
            <div class="form-group">
                <label>الكيك سبونج <span class="required">*</span></label>
                <select name="sponge" id="cakeSponge" required>
                    <option value="">اختر</option>
                    <option value="فانيلا">فانيلا</option>
                    <option value="شوكولاتة">شوكولاتة</option>
                    <option value="مشمش">مشمش</option>
                </select>
            </div>
            
            <div class="form-group">
                <label>الحشوه من الداخل <span class="required">*</span></label>
                <select name="filling" id="cakeFilling" required>
                    <option value="">اختر</option>
                    <option value="كريمة">كريمة</option>
                    <option value="شوكولاتة">شوكولاتة</option>
                    <option value="فراولة">فراولة</option>
                </select>
            </div>
            
            <div class="form-group">
                <label>اضافه <span class="required">*</span></label>
                <select name="addon" id="cakeAddon" required>
                    <option value="">اختر</option>
                    <option value="بدون">بدون</option>
                    <option value="فراولة">فراولة</option>
                    <option value="شوكولاتة">شوكولاتة</option>
                </select>
            </div>
            
            <div class="form-group">
                <label>موعد <span class="required">*</span></label>
                <input type="datetime-local" name="date" id="cakeDate" required>
            </div>
            
            <div class="form-group">
                <label>الكتابه علي قاعدة الكيك</label>
                <textarea name="writing" id="cakeWriting" rows="2" placeholder="اكتب ما تريد"></textarea>
            </div>
            
            <div class="form-group">
                <label>ملاحظه</label>
                <textarea name="note" id="cakeNote" rows="2" placeholder="أي ملاحظات إضافية"></textarea>
            </div>
            
            <div class="form-group">
                <label>المرفقات (صورة التصميم)</label>
                <div class="file-upload-wrap">
                    <input type="file" name="attachment" id="cakeAttachment" accept="image/*" class="file-input">
                    <label for="cakeAttachment" class="file-label">
                        <i class="fas fa-camera"></i> إرفاق ملف
                    </label>
                    <span class="file-name" id="cakeFileName"></span>
                </div>
            </div>
            
            <button type="submit" class="cake-submit-btn">
                <i class="fas fa-cart-plus"></i> أضف للسلة
            </button>
        </form>
    </div>
</div>
