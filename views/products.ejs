<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'ar' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'rtl' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t.products.title %> - <%= t.common.brandName %> - <%= t.common.brandEn %></title>
    <meta name="description" content="<%= t.products.title %> - <%= t.common.brandName %>.">
    <meta name="keywords" content="<%= t.common.brandName %>، منتجات، مطعم، توصيل">
    <meta name="author" content="<%= t.common.brandName %>">
    <% if (typeof siteUrl !== 'undefined' && siteUrl) { %>
    <link rel="canonical" href="<%= siteUrl %>/products">
    <meta property="og:url" content="<%= siteUrl %>/products">
    <% } %>
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= t.products.title %> - <%= t.common.brandName %> - <%= t.common.brandEn %>">
    <meta property="og:description" content="<%= t.products.title %> - <%= t.common.brandName %>.">
    <meta property="og:locale" content="ar_SA">
    <meta property="og:image" content="<%= typeof siteUrl !== 'undefined' && siteUrl ? siteUrl : '' %>/images/logo.png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= t.products.title %> - <%= t.common.brandName %>">
    <meta name="twitter:description" content="<%= t.products.title %> - <%= t.common.brandName %>.">
    <link rel="icon" href="/images/logo.png" type="image/png">
    <link rel="stylesheet" href="/css/style.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <header class="site-header">
        <div class="offers-banner">
            <div class="offers-marquee-wrap" aria-hidden="true">
                <span class="offers-text"><%= offer_text || (typeof t !== 'undefined' && t.offer ? '✨ ' + t.offer : '') %></span>
                <span class="offers-text"><%= offer_text || (typeof t !== 'undefined' && t.offer ? '✨ ' + t.offer : '') %></span>
            </div>
        </div>
        <nav class="topbar">
            <div class="container topbar-content">
                <a href="/" class="logo-area">
                    <img src="/images/logo.png" alt="<%= t.common.brandName %>" class="nav-logo">
                    <span class="brand-name"><%= t.common.brandName %> <em class="brand-en"><%= t.common.brandEn %></em></span>
                </a>
                <ul class="nav-links">
                    <li><a href="/" class="nav-link"><%= t.nav.home %></a></li>
                    <li><a href="/products" class="nav-link active"><%= t.nav.products %></a></li>
                    <li><a href="/parties" class="nav-link"><%= t.nav.parties %></a></li>
                    <li><a href="/cart" class="nav-link nav-cart"><%= t.nav.cart %> <i class="fas fa-shopping-cart"></i></a></li>
                </ul>
                <div class="topbar-social">
                    <a href="https://www.instagram.com/bodatbagdash/" target="_blank" rel="noopener" aria-label="انستغرام"><i class="fab fa-instagram"></i></a>
                    <a href="https://x.com/BodatBagdash" target="_blank" rel="noopener" aria-label="تويتر"><i class="fab fa-twitter"></i></a>
                    <a href="https://www.snapchat.com/@bagdashsweet" target="_blank" rel="noopener" aria-label="سناب شات"><i class="fab fa-snapchat-ghost"></i></a>
                    <a href="https://www.tiktok.com/@bagdashsweet" target="_blank" rel="noopener" aria-label="تيك توك"><i class="fab fa-tiktok"></i></a>
                    <a href="https://www.facebook.com/bagdashsweet/" target="_blank" rel="noopener" aria-label="فيسبوك"><i class="fab fa-facebook-f"></i></a>
                </div>
                <%- include('partials/lang-switcher') %>
                <button type="button" class="burger-btn" id="burgerBtn" aria-label="<%= t.nav.menu %>"><span></span><span></span><span></span></button>
            </div>
        </nav>
    </header>
    <div class="drawer-overlay" id="drawerOverlay" aria-hidden="true"></div>
    <div class="drawer" id="drawer">
        <div class="drawer-header">
            <span class="drawer-title"><%= t.nav.menu %></span>
            <button type="button" class="drawer-close" id="drawerClose" aria-label="<%= t.nav.close %>"><i class="fas fa-times"></i></button>
        </div>
        <nav class="drawer-nav">
            <a href="/" class="drawer-link"><%= t.nav.home %></a>
            <a href="/products" class="drawer-link active"><%= t.nav.products %></a>
            <a href="/parties" class="drawer-link"><%= t.nav.parties %></a>
            <a href="/cart" class="drawer-link"><%= t.nav.cart %> <i class="fas fa-shopping-cart"></i></a>
        </nav>
        <div class="drawer-lang"><%- include('partials/lang-switcher') %></div>
        <div class="drawer-social">
            <span class="drawer-social-label"><%= t.nav.followUs %></span>
            <a href="https://www.instagram.com/bodatbagdash/" target="_blank" rel="noopener" aria-label="انستغرام"><i class="fab fa-instagram"></i></a>
            <a href="https://x.com/BodatBagdash" target="_blank" rel="noopener" aria-label="تويتر"><i class="fab fa-twitter"></i></a>
            <a href="https://www.snapchat.com/@bagdashsweet" target="_blank" rel="noopener" aria-label="سناب شات"><i class="fab fa-snapchat-ghost"></i></a>
            <a href="https://www.tiktok.com/@bagdashsweet" target="_blank" rel="noopener" aria-label="تيك توك"><i class="fab fa-tiktok"></i></a>
            <a href="https://www.facebook.com/bagdashsweet/" target="_blank" rel="noopener" aria-label="فيسبوك"><i class="fab fa-facebook-f"></i></a>
        </div>
    </div>

    <!-- Floating Cart Button -->
    <a href="/cart" class="cart-floating-btn" id="cartBtn">
        <i class="fas fa-shopping-cart"></i>
        <span class="cart-count" id="cartCount">0</span>
    </a>

    <!-- Page Header -->
    <header class="page-header products-page-header" style="background-image: url('https://images.unsplash.com/photo-1488477181946-6428a0291777?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80');">
        <div class="overlay"></div>
        <div class="header-content">
            <div class="header-icon"><i class="fas fa-box-open"></i></div>
            <h1><%= t.products.title %></h1>
            <p><%= t.products.subtitle %></p>
        </div>
    </header>

    <!-- Main Content -->
    <main class="container products-page-main">
        
        <!-- Search & Filter Card -->
        <section class="products-control-card">
            <div class="search-wrapper">
                <div class="search-box">
                    <input type="text" id="productSearch" placeholder="<%= t.products.searchPlaceholder %>" onkeyup="searchProducts()">
                    <button type="button" onclick="searchProducts()"><i class="fas fa-search"></i></button>
                </div>
            </div>
            <div class="categories-filter-wrapper">
                <ul class="category-filter-pills">
                    <li><button type="button" class="category-pill active" data-category="all" onclick="filterProducts('all', event)"><%= t.products.all %></button></li>
                    <% if (categories && categories.length > 0) { %>
                        <% categories.forEach(cat => { %>
                            <li><button type="button" class="category-pill" data-category="<%= cat.name %>" data-category-id="<%= cat.id %>" onclick="filterProducts('<%= cat.name %>', event)"><%= cat.name %></button></li>
                        <% }); %>
                    <% } else { %>
                        <% const uniqueCats = products && products.length ? [...new Set(products.map(p => p.category))] : []; %>
                        <% uniqueCats.forEach((cat) => { %>
                            <li><button type="button" class="category-pill" data-category="<%= cat %>" onclick="filterProducts('<%= cat %>', event)"><%= cat %></button></li>
                        <% }); %>
                    <% } %>
                </ul>
            </div>
        </section>

        <!-- قسم الآيسكريم — مخفي من الواجهة العامة -->
        <% if (false && typeof iceCreamOptions !== 'undefined' && iceCreamOptions && (iceCreamOptions.cupSizes || []).length > 0 && (iceCreamOptions.flavors || []).length > 0) { %>
        <section class="category-block ice-cream-section-products" id="ice-cream-section">
            <div class="category-header">
                <div class="category-title-pill">
                    <h2 class="category-title"><%= t.home.iceCream %></h2>
                </div>
            </div>
            <div class="ice-cream-builder">
                <p class="ice-cream-step-label"><%= t.iceCream.step1 %></p>
                <div class="ice-cream-cup-sizes" id="iceCreamCupSizesProducts">
                    <% (iceCreamOptions.cupSizes || []).forEach(function(cup) { %>
                    <button type="button" class="ice-cream-cup-btn" data-name="<%= cup.name_ar %>" data-price="<%= cup.price %>" data-max-scoops="<%= cup.max_scoops %>" data-image-url="<%= (iceCreamOptions.cupImages && iceCreamOptions.cupImages[cup.name_ar]) ? iceCreamOptions.cupImages[cup.name_ar] : '' %>"><%= cup.name_ar %> — <%= cup.price %> <%= t.common.sar %> (<%= cup.max_scoops %> <%= t.iceCream.balls %>)</button>
                    <% }); %>
                </div>
                <div class="ice-cream-flavors-wrap" id="iceCreamFlavorsWrapProducts" style="display: none;">
                    <p class="ice-cream-step-label"><%= t.iceCream.step2 %></p>
                    <div class="ice-cream-layout">
                        <div class="ice-cream-cup-visual" id="iceCreamCupVisualProducts">
                            <div class="ice-cream-scoops-stack" id="iceCreamScoopsStackProducts"></div>
                            <div class="ice-cream-cup-body" id="iceCreamCupBodyProducts"></div>
                        </div>
                        <div class="ice-cream-flavors-grid" id="iceCreamFlavorsGridProducts">
                            <% (iceCreamOptions.flavors || []).forEach(function(f, fi) { %>
                            <button type="button" class="ice-cream-flavor-btn" data-name="<%= f.name_ar %>" data-index="<%= fi %>"><%= f.name_ar %></button>
                            <% }); %>
                        </div>
                    </div>
                    <div class="ice-cream-current-cup" id="iceCreamCurrentCupProducts">
                        <span class="ice-cream-cup-summary" id="iceCreamCupSummaryProducts"></span>
                        <span class="ice-cream-cup-price" id="iceCreamCupPriceProducts"></span>
                    </div>
                    <button type="button" class="order-btn ice-cream-add-cart-btn" id="iceCreamAddToCartBtnProducts" disabled>
                        <i class="fas fa-cart-plus"></i> <%= t.home.addToCart %>
                    </button>
                </div>
            </div>
        </section>
        <script>
        (function() {
            var scoopColors = ['#fff5e6','#ffb3d9','#8b4513','#4a0080','#0066cc','#ffeb99','#ff6b6b','#ff8c42','#d4a574','#98d8aa','#f5deb3','#1a1a1a'];
            var selectedCup = null, selectedFlavors = [];
            var wrap = document.getElementById('iceCreamFlavorsWrapProducts');
            var cupVisual = document.getElementById('iceCreamCupVisualProducts');
            var scoopsStack = document.getElementById('iceCreamScoopsStackProducts');
            var summary = document.getElementById('iceCreamCupSummaryProducts');
            var priceEl = document.getElementById('iceCreamCupPriceProducts');
            var addBtn = document.getElementById('iceCreamAddToCartBtnProducts');
            if (!wrap || !addBtn) return;
            document.getElementById('iceCreamCupSizesProducts').addEventListener('click', function(e) {
                var btn = e.target.closest('.ice-cream-cup-btn');
                if (!btn) return;
                document.querySelectorAll('#iceCreamCupSizesProducts .ice-cream-cup-btn').forEach(function(b) { b.classList.remove('active'); });
                btn.classList.add('active');
                selectedCup = { name_ar: btn.dataset.name, price: parseFloat(btn.dataset.price), max_scoops: parseInt(btn.dataset.maxScoops, 10), imageUrl: btn.dataset.imageUrl || '' };
                selectedFlavors = [];
                wrap.style.display = 'block';
                if (cupVisual) cupVisual.classList.add('visible');
                if (scoopsStack) scoopsStack.innerHTML = '';
                summary.textContent = '<%= t.iceCream.cupLabel %> ' + selectedCup.name_ar + ': —';
                priceEl.textContent = selectedCup.price + ' <%= t.common.sar %>';
                addBtn.disabled = true;
            });
            document.getElementById('iceCreamFlavorsGridProducts').addEventListener('click', function(e) {
                var btn = e.target.closest('.ice-cream-flavor-btn');
                if (!btn || !selectedCup) return;
                if (selectedFlavors.length >= selectedCup.max_scoops) return;
                var name = btn.getAttribute('data-name') || btn.dataset.name;
                var idx = parseInt(btn.getAttribute('data-index'), 10) || selectedFlavors.length;
                selectedFlavors.push(name);
                var color = scoopColors[idx % scoopColors.length];
                var ball = document.createElement('div');
                ball.className = 'ice-cream-scoop-ball scoop-add';
                ball.style.backgroundColor = color;
                ball.setAttribute('title', name);
                if (scoopsStack) {
                    scoopsStack.appendChild(ball);
                    ball.offsetHeight;
                    ball.classList.add('scoop-visible');
                }
                summary.textContent = '<%= t.iceCream.cupLabel %> ' + selectedCup.name_ar + ': ' + selectedFlavors.join(', ');
                addBtn.disabled = false;
            });
            addBtn.addEventListener('click', function() {
                if (!selectedCup || selectedFlavors.length === 0 || typeof window.addIceCreamToCart !== 'function') return;
                window.addIceCreamToCart(selectedCup, selectedFlavors);
                addBtn.innerHTML = '<i class="fas fa-check"></i> <%= t.iceCream.added %>';
                addBtn.disabled = true;
                setTimeout(function() { addBtn.innerHTML = '<i class="fas fa-cart-plus"></i> <%= t.home.addToCart %>'; addBtn.disabled = selectedFlavors.length === 0; }, 2000);
            });
        })();
        </script>
        <% } %>

        <!-- Products Section -->
        <section class="products-main-content">
            <% if (locals.error) { %>
                <div class="products-error-message">
                    <i class="fas fa-exclamation-circle"></i>
                    <strong><%= t.error %>:</strong> <%= error %>
                </div>
            <% } %>

            <% if (!locals.products || products.length === 0) { %>
                <div class="products-empty-state">
                    <div class="products-empty-icon">
                        <i class="fas fa-shopping-basket"></i>
                    </div>
                    <h3><%= t.products.empty %></h3>
                    <p><%= t.products.emptyDesc %></p>
                    <a href="/" class="products-empty-btn"><i class="fas fa-home"></i> <%= t.products.backToHome %></a>
                </div>
            <% } else { %>
                <!-- All Products Container -->
                <div class="products-grid" id="all-products-grid">
                    <% products.forEach(function(product) { %>
                        <!-- Product Card with category data attribute -->
                        <% 
                            // Determine category identifier (ID or Name) to match filter
                            // If we used ID in filter, we need to map product.category (which is likely name string) to ID or just use Name if simpler
                            // Let's assume product.category stores the Name string based on previous code usage
                            let catId = 'unknown';
                            if (categories && categories.length > 0) {
                                const matchedCat = categories.find(c => c.name === product.category);
                                if (matchedCat) catId = matchedCat.id;
                            } else {
                                catId = product.category; // Fallback
                            }
                        %>
                        <div class="product-card product-item product-has-hover" data-id="<%= product.id %>" data-category-id="<%= catId %>" data-category-name="<%= product.category %>">
                            <a href="/product/<%= product.id %>" class="product-card-link">
                                <div class="product-image">
                                    <img src="<%= (product.images && product.images[0]) || product.image_url || 'https://via.placeholder.com/600x400?text=No+Image' %>" alt="<%= product.name %>" loading="lazy">
                                    <span class="price"><% if (product.sale_price != null && product.sale_price !== '' && (!product.variants || !product.variants.length)) { %><span class="price-old"><%= product.price %> <%= t.common.sar %></span> <span class="price-sale"><%= product.sale_price %> <%= t.common.sar %></span><% } else { %><%= (product.variants && product.variants.length) ? (t.common.priceFrom + ' ' + Math.min(...product.variants.map(v=>parseFloat(v.price)||0)) + ' ' + t.common.sar) : (product.price + ' ' + t.common.sar) %><% } %></span>
                                </div>
                                <div class="product-info">
                                    <h3><%= product.name %></h3>
                                    <p><%= product.description %></p>
                                </div>
                            </a>
                            <div class="product-actions">
                                <button class="order-btn add-to-cart-btn" onclick="event.preventDefault(); event.stopPropagation(); addToCart(<%= JSON.stringify(product) %>)">
                                    <i class="fas fa-cart-plus"></i> <%= t.home.addToCart %>
                                </button>
                                <div class="qty-control-widget" style="display: none;">
                                    <button class="qty-btn minus" onclick="updateItemQty(<%= product.id %>, -1)"><i class="fas fa-minus"></i></button>
                                    <span class="qty-display">1</span>
                                    <button class="qty-btn plus" onclick="updateItemQty(<%= product.id %>, 1)"><i class="fas fa-plus"></i></button>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </section>
    </main>

    <!-- Footer -->
    <footer class="main-footer">
        <div class="footer-content container">
            <div class="footer-col">
                <h3><%= t.footer.brand %></h3>
                <p><%= t.footer.tagline %></p>
            </div>
            <div class="footer-col">
                <h3><%= t.footer.quickLinks %></h3>
                <ul>
                    <li><a href="/"><%= t.nav.home %></a></li>
                    <li><a href="/products"><%= t.nav.products %></a></li>
                    <li><a href="/parties"><%= t.nav.parties %></a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h3><%= t.footer.contact %></h3>
                <p><i class="fas fa-phone"></i> 054 262 9993</p>
                <p><i class="fas fa-map-marker-alt"></i> الدمام • طريق الملك بن عبدالله</p>
                <div class="footer-social">
                    <a href="https://www.instagram.com/bodatbagdash/" target="_blank" rel="noopener" aria-label="انستغرام"><i class="fab fa-instagram"></i></a>
                    <a href="https://x.com/BodatBagdash" target="_blank" rel="noopener" aria-label="تويتر"><i class="fab fa-twitter"></i></a>
                    <a href="https://www.snapchat.com/@bagdashsweet" target="_blank" rel="noopener" aria-label="سناب شات"><i class="fab fa-snapchat-ghost"></i></a>
                    <a href="https://www.tiktok.com/@bagdashsweet" target="_blank" rel="noopener" aria-label="تيك توك"><i class="fab fa-tiktok"></i></a>
                    <a href="https://www.facebook.com/bagdashsweet/" target="_blank" rel="noopener" aria-label="فيسبوك"><i class="fab fa-facebook-f"></i></a>
                </div>
            </div>
            <div class="footer-col footer-commercial-reg">
                <h3><%= t.footer.commercialReg %></h3>
                <div class="commercial-reg-card">
                    <a href="/images/commercial-registration.png" target="_blank" rel="noopener" class="commercial-reg-link" title="<%= t.footer.commercialReg %>">
                        <img src="/images/commercial-registration.png" alt="<%= t.footer.commercialReg %>" class="commercial-reg-img" loading="lazy">
                    </a>
                    <div class="commercial-reg-info">
                        <span class="commercial-reg-label"><%= t.footerExtra.commercialRegNum %></span>
                        <span class="commercial-reg-num">2053033300</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p><%= t.footerExtra.rights %> &copy; 2026 <%= t.common.brandName %> - <%= t.common.brandEn %></p>
        </div>
    </footer>

    <!-- WhatsApp Button -->
    <a href="https://wa.me/966502975175" class="whatsapp-float" target="_blank">
        <i class="fab fa-whatsapp"></i>
    </a>

    <%- include('partials/cake-form-modal') %>
    <%- include('partials/variant-modal') %>
    <script>window.__i18n = window.__i18n || {}; window.__i18n.sar = '<%= t.common.sar %>';</script>
    <script src="/js/main.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>"></script>
    <script>
        // Search Logic
        function searchProducts() {
            const searchInput = document.getElementById('productSearch');
            const filter = searchInput.value.toLowerCase().trim();
            const products = document.querySelectorAll('.product-item');
            
            // Reset category filters visually
            document.querySelectorAll('.category-pill').forEach(btn => {
                btn.classList.remove('active');
            });
            // Set 'All' as active (first one usually)
            const allBtn = document.querySelector('.category-pill'); 
            if(allBtn && allBtn.getAttribute('data-category') === 'all') allBtn.classList.add('active');

            products.forEach(product => {
                const title = product.querySelector('h3').textContent.toLowerCase();
                if (title.includes(filter)) {
                    product.style.display = 'block';
                    product.style.animation = 'fadeIn 0.5s';
                } else {
                    product.style.display = 'none';
                }
            });
        }

        // تطبيق فلتر التصنيف من الرابط ?category=xxx
        const urlParams = new URLSearchParams(window.location.search);
        const categoryFromUrl = urlParams.get('category');
        if (categoryFromUrl) {
            document.querySelectorAll('.category-pill').forEach(btn => {
                btn.classList.remove('active');
                const btnCat = btn.getAttribute('data-category');
                if (btnCat && decodeURIComponent(btnCat) === decodeURIComponent(categoryFromUrl)) {
                    btn.classList.add('active');
                }
            });
            filterProducts(decodeURIComponent(categoryFromUrl));
        }

        // Client-side filtering logic
        function filterProducts(categoryId, ev) {
            const searchInput = document.getElementById('productSearch');
            if(searchInput) searchInput.value = '';

            document.querySelectorAll('.category-pill').forEach(btn => {
                btn.classList.remove('active');
            });
            if (ev && ev.target) ev.target.classList.add('active');

            const products = document.querySelectorAll('.product-item');
            
            products.forEach(product => {
                if (categoryId === 'all') {
                    product.style.display = 'block';
                    // Add animation for reappearing
                    product.style.animation = 'fadeIn 0.5s';
                } else {
                    // Check both ID and Name to be safe
                    const prodCatId = product.getAttribute('data-category-id');
                    const prodCatName = product.getAttribute('data-category-name');
                    
                    if (prodCatId == categoryId || prodCatName == categoryId) {
                        product.style.display = 'block';
                        product.style.animation = 'fadeIn 0.5s';
                    } else {
                        product.style.display = 'none';
                    }
                }
            });
        }
    </script>
</body>
</html>
