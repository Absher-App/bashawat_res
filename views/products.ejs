<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>قائمة المنتجات - بوظة بقداش</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <!-- Offers Banner -->
    <div class="offers-banner">
        <div class="offers-text">
            <%= offer_text || '✨ عروض حصرية لفترة محدودة! اطلب الآن واحصل على توصيل مجاني للطلبات فوق 200 ريال 🍰' %>
        </div>
    </div>

    <!-- Topbar Navigation -->
    <nav class="topbar">
        <div class="container topbar-content">
            <div class="logo-area">
                <img src="/images/logo.png" alt="بوظة بقداش" class="nav-logo">
                <a href="/" class="brand-name"> بوظة بقداش - Bodat Bagdash</a>
            </div>
            <ul class="nav-links">
                <li><a href="/">الرئيسية</a></li>
                <li><a href="/products" class="active">المنتجات</a></li>
                <li><a href="/parties">الحفلات</a></li>
                <li><a href="/cart">السلة <i class="fas fa-shopping-cart"></i></a></li>
            </ul>
        </div>
    </nav>

    <!-- Floating Cart Button -->
    <a href="/cart" class="cart-floating-btn" id="cartBtn">
        <i class="fas fa-shopping-cart"></i>
        <span class="cart-count" id="cartCount">0</span>
    </a>

    <!-- Page Header -->
    <header class="page-header" style="background-image: url('https://images.unsplash.com/photo-1488477181946-6428a0291777?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80');">
        <div class="overlay"></div>
        <div class="header-content">
            <h1>قائمة المنتجات</h1>
            <p>اكتشف تشكيلتنا الواسعة من الحلويات والبوظة العربية</p>
        </div>
    </header>

    <!-- Main Content -->
    <main class="container">
        
        <!-- Professional Search & Filter Section -->
        <section class="products-control-bar">
            <!-- Search Box -->
            <div class="search-wrapper">
                <div class="search-box">
                    <input type="text" id="productSearch" placeholder="ابحث عن منتجك المفضل..." onkeyup="searchProducts()">
                    <button onclick="searchProducts()"><i class="fas fa-search"></i></button>
                </div>
            </div>

            <!-- Horizontal Category Filter -->
            <div class="categories-filter-wrapper">
                <ul class="category-filter-pills">
                    <li><button class="category-pill active" onclick="filterProducts('all')">الكل</button></li>
                    <% if (categories && categories.length > 0) { %>
                        <% categories.forEach(cat => { %>
                            <li><button class="category-pill" onclick="filterProducts('<%= cat.id %>')"><%= cat.name %></button></li>
                        <% }); %>
                    <% } else { %>
                        <!-- Fallback if no categories in DB -->
                        <% const uniqueCats = [...new Set(products.map(p => p.category))]; %>
                        <% uniqueCats.forEach((cat, index) => { %>
                            <li><button class="category-pill" onclick="filterProducts('<%= cat %>')"><%= cat %></button></li>
                        <% }); %>
                    <% } %>
                </ul>
            </div>
        </section>

        <!-- Products Grid -->
        <section class="products-main-content">
            <% if (locals.error) { %>
                <div class="error-message">
                    <strong>تنبيه:</strong> <%= error %>
                </div>
            <% } %>

            <% if (!locals.products || products.length === 0) { %>
                <div class="no-products">
                    <p>لا توجد منتجات متاحة حالياً.</p>
                </div>
            <% } else { %>
                <!-- All Products Container -->
                <div class="products-grid" id="all-products-grid">
                    <% products.forEach(function(product) { %>
                        <!-- Product Card with category data attribute -->
                        <% 
                            // Determine category identifier (ID or Name) to match filter
                            // If we used ID in filter, we need to map product.category (which is likely name string) to ID or just use Name if simpler
                            // Let's assume product.category stores the Name string based on previous code usage
                            let catId = 'unknown';
                            if (categories && categories.length > 0) {
                                const matchedCat = categories.find(c => c.name === product.category);
                                if (matchedCat) catId = matchedCat.id;
                            } else {
                                catId = product.category; // Fallback
                            }
                        %>
                        <div class="product-card product-item" data-id="<%= product.id %>" data-category-id="<%= catId %>" data-category-name="<%= product.category %>">
                            <div class="product-image">
                                <img src="<%= product.image_url || 'https://via.placeholder.com/300x200?text=No+Image' %>" alt="<%= product.name %>">
                                <span class="price"><%= product.price %> ر.س</span>
                            </div>
                            <div class="product-info">
                                <h3><%= product.name %></h3>
                                <p><%= product.description %></p>
                                <div class="product-actions">
                                    <button class="order-btn add-to-cart-btn" onclick="addToCart(<%= JSON.stringify(product) %>)">
                                        <i class="fas fa-cart-plus"></i> أضف للسلة
                                    </button>
                                    <div class="qty-control-widget" style="display: none;">
                                        <button class="qty-btn minus" onclick="updateItemQty(<%= product.id %>, -1)"><i class="fas fa-minus"></i></button>
                                        <span class="qty-display">1</span>
                                        <button class="qty-btn plus" onclick="updateItemQty(<%= product.id %>, 1)"><i class="fas fa-plus"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </section>
    </main>

    <!-- Footer -->
    <footer class="main-footer">
        <div class="footer-content container">
            <div class="footer-col">
                <h3>بوظة بقداش</h3>
                <p>أجود أنواع البقلاوة والشوكولاتة والمعجنات.</p>
            </div>
            <div class="footer-col">
                <h3>روابط سريعة</h3>
                <ul>
                    <li><a href="/">الرئيسية</a></li>
                    <li><a href="/products">المنتجات</a></li>
                    <li><a href="/parties">الحفلات</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h3>تواصل معنا</h3>
                <p><i class="fas fa-phone"></i> 920005031 | واتساب : 0502975175</p>
                <p><i class="fas fa-map-marker-alt"></i> القطيف • سيهات</p>
            </div>
        </div>
        <div class="footer-bottom">
            <p>جميع الحقوق محفوظة &copy; 2026 بوظة بقداش - Bodat Bagdash</p>
        </div>
    </footer>

    <!-- WhatsApp Button -->
    <a href="https://wa.me/966502975175" class="whatsapp-float" target="_blank">
        <i class="fab fa-whatsapp"></i>
    </a>

    <script src="/js/main.js"></script>
    <script>
        // Search Logic
        function searchProducts() {
            const searchInput = document.getElementById('productSearch');
            const filter = searchInput.value.toLowerCase().trim();
            const products = document.querySelectorAll('.product-item');
            
            // Reset category filters visually
            document.querySelectorAll('.category-pill').forEach(btn => {
                btn.classList.remove('active');
            });
            // Set 'All' as active (first one usually)
            const allBtn = document.querySelector('.category-pill'); 
            if(allBtn && allBtn.innerText.includes('الكل')) allBtn.classList.add('active');

            products.forEach(product => {
                const title = product.querySelector('h3').textContent.toLowerCase();
                if (title.includes(filter)) {
                    product.style.display = 'block';
                    product.style.animation = 'fadeIn 0.5s';
                } else {
                    product.style.display = 'none';
                }
            });
        }

        // Client-side filtering logic
        function filterProducts(categoryId) {
            // Clear search input when filtering by category
            const searchInput = document.getElementById('productSearch');
            if(searchInput) searchInput.value = '';

            // Update active button state
            document.querySelectorAll('.category-pill').forEach(btn => {
                btn.classList.remove('active');
            });
            event.target.classList.add('active');

            const products = document.querySelectorAll('.product-item');
            
            products.forEach(product => {
                if (categoryId === 'all') {
                    product.style.display = 'block';
                    // Add animation for reappearing
                    product.style.animation = 'fadeIn 0.5s';
                } else {
                    // Check both ID and Name to be safe
                    const prodCatId = product.getAttribute('data-category-id');
                    const prodCatName = product.getAttribute('data-category-name');
                    
                    if (prodCatId == categoryId || prodCatName == categoryId) {
                        product.style.display = 'block';
                        product.style.animation = 'fadeIn 0.5s';
                    } else {
                        product.style.display = 'none';
                    }
                }
            });
        }
    </script>
</body>
</html>
