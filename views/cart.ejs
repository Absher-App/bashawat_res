<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'ar' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'rtl' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t.cart.title %> - <%= t.common.brandName %> - <%= t.common.brandEn %></title>
    <meta name="description" content="<%= t.cart.title %> - <%= t.common.brandName %>.">
    <meta name="robots" content="noindex, follow">
    <% if (typeof siteUrl !== 'undefined' && siteUrl) { %>
    <link rel="canonical" href="<%= siteUrl %>/cart">
    <meta property="og:url" content="<%= siteUrl %>/cart">
    <% } %>
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= t.cart.title %> - <%= t.common.brandName %> - <%= t.common.brandEn %>">
    <meta property="og:description" content="<%= t.cart.title %> - <%= t.common.brandName %>.">
    <meta property="og:locale" content="ar_SA">
    <meta property="og:image" content="<%= typeof siteUrl !== 'undefined' && siteUrl ? siteUrl : '' %>/images/logo.png?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>">
    <link rel="icon" href="/images/logo.png?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>" type="image/png">
    <link rel="stylesheet" href="/css/style.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <header class="site-header">
        <div class="offers-banner">
            <% const cartOfferText = typeof offer_text !== 'undefined' && offer_text ? offer_text : (typeof t !== 'undefined' && t.offer ? '✨ ' + t.offer : ''); %>
            <div class="offers-marquee-wrap" aria-hidden="true">
                <span class="offers-text"><%= cartOfferText %></span>
                <span class="offers-text"><%= cartOfferText %></span>
            </div>
        </div>
        <nav class="topbar">
            <div class="container topbar-content">
                <a href="/" class="logo-area">
                    <img src="/images/logo.png?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>" alt="<%= t.common.brandName %>" class="nav-logo">
                    <span class="brand-name"><%= t.common.brandName %> <em class="brand-en"><%= t.common.brandEn %></em></span>
                </a>
                <ul class="nav-links">
                    <li><a href="/" class="nav-link"><%= t.nav.home %></a></li>
                    <li><a href="/products" class="nav-link"><%= t.nav.products %></a></li>
                    <li><a href="/cart" class="nav-link nav-cart active"><%= t.nav.cart %> <i class="fas fa-shopping-cart"></i></a></li>
                </ul>
                <div class="topbar-social">
                    <a href="https://www.instagram.com/bashawathouserest/" target="_blank" rel="noopener" aria-label="انستغرام"><i class="fab fa-instagram"></i></a>
                    <a href="https://x.com/BodatBagdash" target="_blank" rel="noopener" aria-label="تويتر"><i class="fab fa-twitter"></i></a>
                    <a href="https://www.snapchat.com/@bagdashsweet" target="_blank" rel="noopener" aria-label="سناب شات"><i class="fab fa-snapchat-ghost"></i></a>
                    <a href="https://www.tiktok.com/@bagdashsweet" target="_blank" rel="noopener" aria-label="تيك توك"><i class="fab fa-tiktok"></i></a>
                    <a href="https://www.facebook.com/bagdashsweet/" target="_blank" rel="noopener" aria-label="فيسبوك"><i class="fab fa-facebook-f"></i></a>
                </div>
                <%- include('partials/lang-switcher') %>
                <button type="button" class="burger-btn" id="burgerBtn" aria-label="<%= t.nav.menu %>"><span></span><span></span><span></span></button>
            </div>
        </nav>
    </header>
    <div class="drawer-overlay" id="drawerOverlay" aria-hidden="true"></div>
    <div class="drawer" id="drawer">
        <div class="drawer-header">
            <span class="drawer-title"><%= t.nav.menu %></span>
            <button type="button" class="drawer-close" id="drawerClose" aria-label="<%= t.nav.close %>"><i class="fas fa-times"></i></button>
        </div>
        <nav class="drawer-nav">
            <a href="/" class="drawer-link"><%= t.nav.home %></a>
            <a href="/products" class="drawer-link"><%= t.nav.products %></a>
            <a href="/cart" class="drawer-link active"><%= t.nav.cart %> <i class="fas fa-shopping-cart"></i></a>
        </nav>
        <div class="drawer-lang"><%- include('partials/lang-switcher') %></div>
        <div class="drawer-social">
            <span class="drawer-social-label"><%= t.nav.followUs %></span>
            <a href="https://www.instagram.com/bashawathouserest/" target="_blank" rel="noopener" aria-label="انستغرام"><i class="fab fa-instagram"></i></a>
            <a href="https://x.com/BodatBagdash" target="_blank" rel="noopener" aria-label="تويتر"><i class="fab fa-twitter"></i></a>
            <a href="https://www.snapchat.com/@bagdashsweet" target="_blank" rel="noopener" aria-label="سناب شات"><i class="fab fa-snapchat-ghost"></i></a>
            <a href="https://www.tiktok.com/@bagdashsweet" target="_blank" rel="noopener" aria-label="تيك توك"><i class="fab fa-tiktok"></i></a>
            <a href="https://www.facebook.com/bagdashsweet/" target="_blank" rel="noopener" aria-label="فيسبوك"><i class="fab fa-facebook-f"></i></a>
        </div>
    </div>

    <header class="page-header cart-page-header" style="background-image: url('https://images.unsplash.com/photo-1559339352-11d035aa65de?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80');">
        <div class="overlay"></div>
        <div class="header-content">
            <div class="header-icon"><i class="fas fa-shopping-cart"></i></div>
            <h1><%= t.cart.title %></h1>
            <p><%= t.cart.subtitle %></p>
        </div>
    </header>

    <main class="container cart-page-container">
        <div class="cart-layout" id="cartLayout">
            <div class="cart-items-section">
                <div class="cart-items-card">
                    <h2 class="cart-section-title cart-section-title-products"><i class="fas fa-box-open"></i> <%= t.cart.yourProducts %></h2>
                    <div id="fullCartItems">
                        <div class="loading-cart"><%= t.cart.loading %></div>
                    </div>
                </div>
            </div>

            <div class="cart-summary-section">
                <div class="cart-summary-card">
                    <h3><%= t.cart.orderSummary %></h3>
                    <div class="summary-row">
                        <span><%= t.cart.subtotal %></span>
                        <span id="subTotal">0.00 <%= t.common.sar %></span>
                    </div>
                    <div class="summary-row summary-tax">
                        <span><%= t.cart.tax %></span>
                        <span id="taxAmount">0.00 <%= t.common.sar %></span>
                    </div>
                    <hr>
                    <div class="summary-row total">
                        <span><%= t.cart.total %></span>
                        <span id="finalTotal">0.00 <%= t.common.sar %></span>
                    </div>
                    
                    <button class="checkout-btn" id="pageCheckoutBtn">
                        <i class="fa-brands fa-apple"></i> إتمام الطلب والدفع
                    </button>
                    
                    <a href="/products" class="continue-shopping">
                        <i class="fas fa-arrow-right"></i> <%= t.cart.continueShopping %>
                    </a>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="main-footer">
        <div class="footer-content container">
            <div class="footer-col">
                <h3><%= t.footer.brand %></h3>
                <p><%= t.footer.tagline %></p>
            </div>
            <div class="footer-col">
                <h3><%= t.footer.quickLinks %></h3>
                <ul>
                    <li><a href="/"><%= t.nav.home %></a></li>
                    <li><a href="/#products-section"><%= t.nav.products %></a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h3><%= t.footer.contact %></h3>
                <p><i class="fas fa-phone"></i> 054 262 9993</p>
                <p><i class="fas fa-map-marker-alt"></i> الدمام • طريق الملك بن عبدالله</p>
                <div class="footer-social">
                    <a href="https://www.instagram.com/bashawathouserest/" target="_blank" rel="noopener" aria-label="انستغرام"><i class="fab fa-instagram"></i></a>
                    <a href="https://x.com/BodatBagdash" target="_blank" rel="noopener" aria-label="تويتر"><i class="fab fa-twitter"></i></a>
                    <a href="https://www.snapchat.com/@bagdashsweet" target="_blank" rel="noopener" aria-label="سناب شات"><i class="fab fa-snapchat-ghost"></i></a>
                    <a href="https://www.tiktok.com/@bagdashsweet" target="_blank" rel="noopener" aria-label="تيك توك"><i class="fab fa-tiktok"></i></a>
                    <a href="https://www.facebook.com/bagdashsweet/" target="_blank" rel="noopener" aria-label="فيسبوك"><i class="fab fa-facebook-f"></i></a>
                </div>
            </div>
            <div class="footer-col footer-commercial-reg">
                <h3><%= t.footer.commercialReg %></h3>
                <div class="commercial-reg-card">
                    <a href="/images/commercial-registration.png" target="_blank" rel="noopener" class="commercial-reg-link" title="<%= t.footer.commercialReg %>">
                        <img src="/images/commercial-registration.png" alt="<%= t.footer.commercialReg %>" class="commercial-reg-img" loading="lazy">
                    </a>
                    <div class="commercial-reg-info">
                        <span class="commercial-reg-label"><%= t.footerExtra.commercialRegNum %></span>
                        <span class="commercial-reg-num">2053033300</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p><%= t.footerExtra.rights %> &copy; 2026 <%= t.common.brandName %> - <%= t.common.brandEn %></p>
        </div>
    </footer>

    <!-- WhatsApp Button -->
    <a href="https://wa.me/966542629993" class="whatsapp-float" target="_blank">
        <i class="fab fa-whatsapp"></i>
    </a>

    <script>
    window.__i18n = window.__i18n || {};
    window.__i18n.sar = '<%= t.common.sar %>';
    window.__i18n.cartEmpty = '<%= t.cart.empty %>';
    window.__i18n.cartEmptyDesc = '<%= t.cart.emptyDesc %>';
    window.__i18n.continueShopping = '<%= t.cart.continueShopping %>';
    window.__i18n.backToHome = '<%= t.cart.backToHome %>';
    window.__i18n.subtotal = '<%= t.cart.subtotal %>';
    window.__i18n.tax = '<%= t.cart.tax %>';
    window.__i18n.total = '<%= t.cart.total %>';
    window.__i18n.totalLabel = '<%= t.cart.totalLabel %>';
    window.__PAYMENTS__ = window.__PAYMENTS__ || {};
    window.__PAYMENTS__.enabled = <%= paymentsEnabled ? 'true' : 'false' %>;
</script>
    <script src="/js/main.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>"></script>
</body>
</html>
