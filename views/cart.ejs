<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>سلة المشتريات - حلويات بقداش - Bagdash sweets</title>
    <link rel="stylesheet" href="/css/style.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <header class="site-header">
        <div class="offers-banner">
            <% const cartOfferText = typeof offer_text !== 'undefined' && offer_text ? offer_text : '✨ توصيل مجاني للطلبات فوق 200 ريال — عروض حصرية لفترة محدودة'; %>
            <div class="offers-marquee-wrap" aria-hidden="true">
                <span class="offers-text"><%= cartOfferText %></span>
                <span class="offers-text"><%= cartOfferText %></span>
            </div>
        </div>
        <nav class="topbar">
            <div class="container topbar-content">
                <a href="/" class="logo-area">
                    <img src="/images/logo.png" alt="حلويات بقداش" class="nav-logo">
                    <span class="brand-name">حلويات بقداش <em class="brand-en">Bagdash sweets</em></span>
                </a>
                <ul class="nav-links">
                    <li><a href="/" class="nav-link">الرئيسية</a></li>
                    <li><a href="/products" class="nav-link">المنتجات</a></li>
                    <li><a href="/parties" class="nav-link">الحفلات</a></li>
                    <li><a href="/cart" class="nav-link nav-cart active">السلة <i class="fas fa-shopping-cart"></i></a></li>
                </ul>
                <div class="topbar-social">
                    <a href="https://www.instagram.com/bodatbagdash/" target="_blank" rel="noopener" aria-label="انستغرام"><i class="fab fa-instagram"></i></a>
                    <a href="https://twitter.com" target="_blank" rel="noopener" aria-label="تويتر"><i class="fab fa-twitter"></i></a>
                    <a href="https://snapchat.com" target="_blank" rel="noopener" aria-label="سناب شات"><i class="fab fa-snapchat-ghost"></i></a>
                    <a href="https://facebook.com" target="_blank" rel="noopener" aria-label="فيسبوك"><i class="fab fa-facebook-f"></i></a>
                </div>
            </div>
        </nav>
    </header>

    <header class="page-header cart-page-header" style="background-image: url('https://images.unsplash.com/photo-1559339352-11d035aa65de?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80');">
        <div class="overlay"></div>
        <div class="header-content">
            <div class="header-icon"><i class="fas fa-shopping-cart"></i></div>
            <h1>سلة المشتريات</h1>
            <p>مراجعة طلبك وإتمامه</p>
        </div>
    </header>

    <main class="container cart-page-container">
        <div class="cart-layout" id="cartLayout">
            <div class="cart-items-section">
                <div class="cart-items-card">
                    <h2 class="cart-section-title cart-section-title-products"><i class="fas fa-box-open"></i> منتجاتك</h2>
                    <div id="fullCartItems">
                    <!-- سيتم ملء المنتجات هنا بواسطة JavaScript -->
                        <div class="loading-cart">جاري تحميل السلة...</div>
                    </div>
                </div>
            </div>

            <div class="cart-summary-section">
                <div class="cart-summary-card">
                    <h3>ملخص الطلب</h3>
                    <div class="summary-row">
                        <span>المجموع الفرعي:</span>
                        <span id="subTotal">0.00 ر.س</span>
                    </div>
                    <div class="summary-row summary-tax">
                        <span>الضريبة (0%):</span>
                        <span id="taxAmount">0.00 ر.س</span>
                    </div>
                    <hr>
                    <div class="summary-row total">
                        <span>الإجمالي:</span>
                        <span id="finalTotal">0.00 ر.س</span>
                    </div>
                    
                    <button class="checkout-btn" id="pageCheckoutBtn">
                        <i class="fab fa-whatsapp"></i> إتمام الطلب عبر واتساب
                    </button>
                    
                    <a href="/products" class="continue-shopping">
                        <i class="fas fa-arrow-right"></i> متابعة التسوق
                    </a>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="main-footer">
        <div class="footer-content container">
            <div class="footer-col">
                <h3>بقداش</h3>
                <p>أجود أنواع البقلاوة والشوكولاتة والمعجنات.</p>
            </div>
            <div class="footer-col">
                <h3>روابط سريعة</h3>
                <ul>
                    <li><a href="/">الرئيسية</a></li>
                    <li><a href="/#products-section">المنتجات</a></li>
                    <li><a href="/parties">الحفلات</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h3>تواصل معنا</h3>
                <p><i class="fas fa-phone"></i> 920005031</p>
                <p><i class="fas fa-map-marker-alt"></i> القطيف • سيهات</p>
                <div class="footer-social">
                    <a href="https://www.instagram.com/bodatbagdash/" target="_blank" rel="noopener" aria-label="انستغرام"><i class="fab fa-instagram"></i></a>
                    <a href="https://twitter.com" target="_blank" rel="noopener" aria-label="تويتر"><i class="fab fa-twitter"></i></a>
                    <a href="https://snapchat.com" target="_blank" rel="noopener" aria-label="سناب شات"><i class="fab fa-snapchat-ghost"></i></a>
                    <a href="https://facebook.com" target="_blank" rel="noopener" aria-label="فيسبوك"><i class="fab fa-facebook-f"></i></a>
                </div>
            </div>
            <div class="footer-col footer-commercial-reg">
                <h3>السجل التجاري</h3>
                <div class="commercial-reg-card">
                    <a href="/images/commercial-registration.png" target="_blank" rel="noopener" class="commercial-reg-link" title="شركة بوطة بقداش التجارية - اضغط للتحقق">
                        <img src="/images/commercial-registration.png" alt="السجل التجاري - شركة بوطة بقداش 2053033300" class="commercial-reg-img" loading="lazy">
                    </a>
                    <div class="commercial-reg-info">
                        <span class="commercial-reg-label">رقم السجل</span>
                        <span class="commercial-reg-num">2053033300</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>جميع الحقوق محفوظة &copy; 2026 بقداش للحلويات</p>
        </div>
    </footer>

    <!-- WhatsApp Button -->
    <a href="https://wa.me/966502975175" class="whatsapp-float" target="_blank">
        <i class="fab fa-whatsapp"></i>
    </a>

    <script src="/js/main.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>"></script>
</body>
</html>
